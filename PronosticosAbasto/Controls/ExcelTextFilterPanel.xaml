<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PronosticosAbasto.Controls.ExcelTextFilterPanel"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Width="{x:Bind PanelWidth}" Spacing="6">
        <Button
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Padding="8,5"
            Background="Transparent"
            BorderThickness="0"
            Command="{x:Bind SortAscendingCommand, Mode=OneWay}"
            CommandParameter="{x:Bind SortCommandParameter, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="A-Z" FontFamily="{StaticResource GuardianMonoFontFamily}" />
                <TextBlock Text="Ordenar de A a Z" />
            </StackPanel>
        </Button>

        <Button
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Padding="8,5"
            Background="Transparent"
            BorderThickness="0"
            Command="{x:Bind SortDescendingCommand, Mode=OneWay}"
            CommandParameter="{x:Bind SortCommandParameter, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Z-A" FontFamily="{StaticResource GuardianMonoFontFamily}" />
                <TextBlock Text="Ordenar de Z a A" />
            </StackPanel>
        </Button>

        <Rectangle Height="1" Fill="{ThemeResource GuardianBorderSoftBrush}" Margin="0,2" />

        <Button
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Padding="8,5"
            Background="Transparent"
            BorderThickness="0"
            Command="{Binding Filter.ClearCommand, ElementName=Root}">
            <TextBlock Text="{x:Bind ClearFilterText}" Foreground="{ThemeResource GuardianTextSecondaryBrush}" />
        </Button>

        <TextBlock Text="Filtros de texto" Padding="8,4,8,2" Foreground="{ThemeResource GuardianTextSecondaryBrush}" />

        <TextBox
            PlaceholderText="{x:Bind PlaceholderText}"
            Style="{StaticResource GuardianTextBoxStyle}"
            Text="{Binding Filter.OptionSearchText, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <CheckBox
            Content="(Seleccionar todo)"
            IsThreeState="True"
            IsChecked="{Binding Filter.VisibleOptionsSelectionState, ElementName=Root, Mode=TwoWay}" />
        <Border
            BorderBrush="{ThemeResource GuardianBorderSoftBrush}"
            BorderThickness="1"
            CornerRadius="0"
            Padding="0">
            <ListView
                MaxHeight="230"
                MinHeight="150"
                ItemsSource="{Binding Filter.FilteredOptions, ElementName=Root, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <CheckBox
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            HorizontalAlignment="Stretch">
                            <TextBlock
                                Text="{Binding DisplayValue}"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis" />
                        </CheckBox>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
        <TextBlock
            Text="{Binding Filter.SelectionSummary, ElementName=Root, Mode=OneWay}"
            FontSize="11"
            Foreground="{ThemeResource GuardianTextSecondaryBrush}" />
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                Content="ACEPTAR"
                HorizontalAlignment="Right"
                MinWidth="88"
                Padding="12,6"
                Click="AcceptButton_Click"
                Style="{StaticResource GuardianPrimaryButtonStyle}" />
            <Button
                Grid.Column="1"
                Content="Cancelar"
                HorizontalAlignment="Left"
                MinWidth="88"
                Padding="12,6"
                Click="CancelButton_Click"
                Style="{StaticResource GuardianSecondaryButtonStyle}" />
        </Grid>
    </StackPanel>
</UserControl>
