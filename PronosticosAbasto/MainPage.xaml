                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" MinHeight="36" Padding="12,8" ColumnSpacing="6" Background="{StaticResource StitchTableHeaderBrush}" BorderBrush="{StaticResource StitchBorderBrush}" BorderThickness="0,0,0,1" Tag="TransferTable" Loaded="TableHeaderGrid_Loaded">
