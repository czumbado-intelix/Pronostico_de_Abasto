                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind DifferenceText}"
                                        TextAlignment="Center"
                                        IsTextSelectionEnabled="True"
                                        ToolTipService.ToolTip="Diferencia entre inventario principal y forecast"
                                        Style="{StaticResource GuardianMonoTextStyle}" />
