                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{x:Bind Pallet}" IsTextSelectionEnabled="True" Style="{StaticResource GuardianMonoTextStyle}" />
                                    <TextBlock Text="{x:Bind Location}" TextWrapping="Wrap" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                    <TextBlock Text="{x:Bind StorageZone}" TextWrapping="Wrap" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind ValidationDateText}" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                        <TextBlock Text="{x:Bind Origin}" Style="{StaticResource GuardianStrongTextStyle}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind QuantityText}" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource GuardianMonoTextStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</Page>

