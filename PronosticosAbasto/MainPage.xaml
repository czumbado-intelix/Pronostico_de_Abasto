                                                    <TextBlock Text="{x:Bind QuantityText}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{x:Bind Location}" TextWrapping="Wrap" Style="{StaticResource GuardianStrongTextStyle}" />
                                            <TextBlock Text="{x:Bind StorageZone}" TextWrapping="Wrap" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                            <Grid BorderBrush="{StaticResource StitchPrimaryBorderBrush}" BorderThickness="0,1,0,0" Padding="0,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind ValidationDateText}" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Origin}" Foreground="{StaticResource StitchPrimaryBrush}" Style="{StaticResource GuardianStrongTextStyle}" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <Border Grid.Row="3" Padding="20,14" BorderBrush="{StaticResource StitchBorderBrush}" BorderThickness="0,1,0,0">
                    <Button Click="CloseTransferPalletPane_Click" HorizontalAlignment="Stretch" Style="{StaticResource GuardianPrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="16" Foreground="White" />
                            <TextBlock Text="Confirmar seleccion de pallets" />
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>
    </Grid>

    <Grid
        Canvas.ZIndex="81"
        Visibility="{x:Bind ViewModel.ExpedicionPalletPaneVisibility, Mode=OneWay}">
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition FromHorizontalOffset="28" />
                <RepositionThemeTransition />
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <Border Background="#66000000" Tapped="ExpedicionPalletOverlayBackground_Tapped" />

        <Border
            Width="460"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Padding="18"
            Background="{StaticResource StitchSurfaceBrush}"
            BorderBrush="{StaticResource StitchBorderBrush}"
            BorderThickness="1,0,0,0"
            DataContext="{x:Bind ViewModel.SelectedExpedicionRow, Mode=OneWay}"
            Tapped="ExpedicionPalletPane_Tapped">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="Palets a traer" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource StitchTextPrimaryBrush}" />
                        <TextBlock Text="{Binding ArticleDescriptionText}" TextWrapping="Wrap" Style="{StaticResource GuardianEyebrowTextStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="CloseExpedicionPalletPane_Click" Width="36" Height="36" Padding="0" Style="{StaticResource GuardianSecondaryButtonStyle}">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="12" Foreground="{StaticResource StitchTextPrimaryBrush}" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="12,10" Background="{StaticResource StitchPrimarySoftBrush}" BorderBrush="{StaticResource StitchPrimaryBorderBrush}" BorderThickness="1" CornerRadius="4">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Cantidad" Style="{StaticResource GuardianEyebrowTextStyle}" />
                            <TextBlock Text="{Binding TransferSuggestionText}" Style="{StaticResource GuardianStrongTextStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Padding="12,10" Background="{StaticResource StitchPrimarySoftBrush}" BorderBrush="{StaticResource StitchPrimaryBorderBrush}" BorderThickness="1" CornerRadius="4">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Palets" Style="{StaticResource GuardianEyebrowTextStyle}" />
                            <TextBlock Text="{Binding SuggestedPalletCountText}" Style="{StaticResource GuardianStrongTextStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="12,10" Background="{StaticResource StitchPrimarySoftBrush}" BorderBrush="{StaticResource StitchPrimaryBorderBrush}" BorderThickness="1" CornerRadius="4">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Sobrante" Style="{StaticResource GuardianEyebrowTextStyle}" />
                            <TextBlock Text="{Binding PalletRoundUpSurplusText}" Style="{StaticResource GuardianStrongTextStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <ListView
                    Grid.Row="2"
                    MinHeight="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource GuardianListViewItemStyle}"
                    ItemsSource="{Binding PalletOptions}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:PalletSelectionViewModel">
                            <Grid Padding="0,10" ColumnSpacing="12" BorderBrush="{StaticResource StitchBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="74" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" VerticalAlignment="Top" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{x:Bind Pallet}" IsTextSelectionEnabled="True" Style="{StaticResource GuardianMonoTextStyle}" />
                                    <TextBlock Text="{x:Bind Location}" TextWrapping="Wrap" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                    <TextBlock Text="{x:Bind StorageZone}" TextWrapping="Wrap" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind ValidationDateText}" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                        <TextBlock Text="{x:Bind Origin}" Style="{StaticResource GuardianStrongTextStyle}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind QuantityText}" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource GuardianMonoTextStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</Page>

