                                    <TextBlock
                                        Grid.Column="11"
                                        Visibility="Collapsed"
                                        Text="{x:Bind TarimaSizeText}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource GuardianMonoTextStyle}" />
