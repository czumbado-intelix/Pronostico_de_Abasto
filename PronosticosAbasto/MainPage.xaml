                                <TextBlock Text="Carga de trabajo proyectada" Style="{StaticResource GuardianStrongTextStyle}" />
                                <TextBlock Text="Volumen de traslado por periodo" Style="{StaticResource GuardianEyebrowTextStyle}" />
