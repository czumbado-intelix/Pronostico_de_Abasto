<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PronosticosAbasto.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:PronosticosAbasto.ViewModels"
    xmlns:controls="using:PronosticosAbasto.Controls"
    xmlns:converters="using:PronosticosAbasto.Converters"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    Background="{ThemeResource GuardianWindowBackgroundBrush}"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <!-- Ctrl+F lleva al buscador del modulo visible. -->
        <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="FocusSearch_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <converters:BoolToAccentBrushConverter x:Key="FilterBrushConverter" />
        <converters:BoolToCardBrushConverter x:Key="TabBrushConverter" />
        <converters:BoolToSelectedTabBackgroundBrushConverter x:Key="SelectedTabBackgroundBrushConverter" />
        <converters:BoolToSelectedTabForegroundBrushConverter x:Key="SelectedTabForegroundBrushConverter" />
        <converters:BoolToSelectedTabBorderBrushConverter x:Key="SelectedTabBorderBrushConverter" />
        <converters:BoolToCollapsedSidebarIconForegroundBrushConverter x:Key="CollapsedSidebarIconForegroundBrushConverter" />
        <converters:BoolToSidebarItemBackgroundBrushConverter x:Key="SidebarItemBackgroundBrushConverter" />
        <converters:BoolToSidebarItemForegroundBrushConverter x:Key="SidebarItemForegroundBrushConverter" />
        <converters:BoolToSidebarItemRailBrushConverter x:Key="SidebarItemRailBrushConverter" />
        <converters:BoolToSegmentTabBackgroundBrushConverter x:Key="SegmentTabBackgroundBrushConverter" />
        <converters:BoolToSegmentTabForegroundBrushConverter x:Key="SegmentTabForegroundBrushConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid
        x:Name="ShellRoot"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
        <Grid.Resources>
            <Storyboard x:Key="OpenSideNavStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="ExpandedSideNav"
                    Storyboard.TargetProperty="Width"
                    To="236"
                    Duration="0:0:0.18">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <ColorAnimation
                    Storyboard.TargetName="ExpandedSideNavBackgroundBrush"
                    Storyboard.TargetProperty="Color"
                    To="#FFFFFF"
                    Duration="0:0:0.18" />
                <DoubleAnimation
                    Storyboard.TargetName="ExpandedSideNavContent"
                    Storyboard.TargetProperty="Opacity"
                    To="1"
                    BeginTime="0:0:0.05"
                    Duration="0:0:0.13">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="SideNavDimOverlay"
                    Storyboard.TargetProperty="Opacity"
                    To="1"
                    Duration="0:0:0.18">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Key="CloseSideNavStoryboard" Completed="CloseSideNavStoryboard_Completed">
                <DoubleAnimation
                    Storyboard.TargetName="ExpandedSideNav"
                    Storyboard.TargetProperty="Width"
                    To="0"
                    Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <ColorAnimation
                    Storyboard.TargetName="ExpandedSideNavBackgroundBrush"
                    Storyboard.TargetProperty="Color"
                    To="#FFFFFF"
                    Duration="0:0:0.16" />
                <DoubleAnimation
                    Storyboard.TargetName="ExpandedSideNavContent"
                    Storyboard.TargetProperty="Opacity"
                    To="0"
                    Duration="0:0:0.10">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="SideNavDimOverlay"
                    Storyboard.TargetProperty="Opacity"
                    To="0"
                    Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Grid.Resources>

    <NavigationView
        x:Name="NavView"
        Margin="72,0,0,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        IsBackButtonVisible="Collapsed"
        IsPaneVisible="False"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="False"
        CompactPaneLength="72"
        IsPaneOpen="False"
        PaneDisplayMode="LeftCompact"
        OpenPaneLength="256"
        SelectionChanged="NavView_SelectionChanged">
        <NavigationView.Resources>
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#000000" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#000000" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#000000" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemIconForeground" Color="#6B7280" />
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundPointerOver" Color="#000000" />
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundPressed" Color="#000000" />
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelected" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelectedPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelectedPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#00A88F" Opacity="0.10" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#00A88F" Opacity="0.18" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#00A88F" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#00A88F" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#00977F" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#00A88F" />
        </NavigationView.Resources>
        <NavigationView.PaneHeader>
            <Grid Height="76" Padding="16,0,16,0" BorderBrush="{StaticResource StitchBorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource StitchSurfaceBrush}" BorderBrush="{StaticResource StitchBorderBrush}" BorderThickness="1">
                        <Image Source="ms-appx:///Assets/BrandLogo.png" Stretch="Uniform" />
                    </Border>
                    <StackPanel Spacing="0" VerticalAlignment="Center" Width="150">
                        <TextBlock Text="Pronostico de Abasto" FontFamily="{StaticResource GuardianFontFamily}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource StitchTextPrimaryBrush}" />
                        <TextBlock Text="LOGISTICA &amp; SUPPLY" FontFamily="{StaticResource GuardianFontFamily}" FontSize="10" FontWeight="Medium" CharacterSpacing="40" Foreground="{StaticResource StitchTextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Traslados" Tag="Traslados" IsSelected="True" MinHeight="52" Margin="8,4" FontSize="16" FontWeight="SemiBold">
                <NavigationViewItem.Icon>
                    <PathIcon Width="24" Height="24" Data="M7 7 L17 7 L14 4 L15.4 2.6 L20.8 8 L15.4 13.4 L14 12 L17 9 L7 9 Z M17 17 L7 17 L10 20 L8.6 21.4 L3.2 16 L8.6 10.6 L10 12 L7 15 L17 15 Z" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Expediciones" Tag="Expediciones" MinHeight="52" Margin="8,4" FontSize="16" FontWeight="SemiBold">
                <NavigationViewItem.Icon>
                    <PathIcon Width="24" Height="24" Data="M3 6 L15 6 L15 16 L13 16 C12.7 17.7 11.3 19 9.5 19 C7.7 19 6.3 17.7 6 16 L3 16 Z M16 9 L20 9 L23 13 L23 16 L21 16 C20.7 17.7 19.3 19 17.5 19 C15.7 19 14.3 17.7 14 16 L16 16 Z M8 15.5 C8 16.3 8.7 17 9.5 17 C10.3 17 11 16.3 11 15.5 C11 14.7 10.3 14 9.5 14 C8.7 14 8 14.7 8 15.5 Z M16 15.5 C16 16.3 16.7 17 17.5 17 C18.3 17 19 16.3 19 15.5 C19 14.7 18.3 14 17.5 14 C16.7 14 16 14.7 16 15.5 Z M17 10.5 L17 13 L20.5 13 L18.7 10.5 Z" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Transito" Tag="Transito" MinHeight="52" Margin="8,4" FontSize="16" FontWeight="SemiBold">
                <NavigationViewItem.Icon>
                    <PathIcon Width="24" Height="24" Data="M12 2 C6.5 2 2 6.5 2 12 C2 17.5 6.5 22 12 22 C17.5 22 22 17.5 22 12 C22 6.5 17.5 2 12 2 Z M12 4 C16.4 4 20 7.6 20 12 C20 16.4 16.4 20 12 20 C7.6 20 4 16.4 4 12 C4 7.6 7.6 4 12 4 Z M11 7 L13 7 L13 11.4 L16.8 13.7 L15.8 15.4 L11 12.5 Z" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Comparativa e histograma" Tag="Comparativa" MinHeight="52" Margin="8,4" FontSize="16" FontWeight="SemiBold">
                <NavigationViewItem.Icon>
                    <PathIcon Width="24" Height="24" Data="M4 11 L8 11 L8 20 L4 20 Z M10 4 L14 4 L14 20 L10 20 Z M16 8 L20 8 L20 20 L16 20 Z M3 21 L21 21 L21 23 L3 23 Z" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Simulacion" Tag="Simulacion" MinHeight="52" Margin="8,4" FontSize="16" FontWeight="SemiBold">
                <NavigationViewItem.Icon>
                    <PathIcon Width="24" Height="24" Data="M9 2 L15 2 L15 4 L14 4 L14 9.2 L20.5 20.5 C21.1 21.5 20.4 23 19.2 23 L4.8 23 C3.6 23 2.9 21.5 3.5 20.5 L10 9.2 L10 4 L9 4 Z M12 10.1 L5.8 21 L18.2 21 Z M8 17 L16 17 L18 20 L6 20 Z" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.PaneFooter>
            <StackPanel Padding="12,4,12,12" Spacing="2">
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8,8"
                    Command="{x:Bind ViewModel.ManageSettingsCommand}"
                    ToolTipService.ToolTip="Ajustes: umbrales, zonas externas, alistado satelital y tamanos de tarima">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="18" />
                        <TextBlock Text="Ajustes" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8,8"
                    Click="Help_Click"
                    ToolTipService.ToolTip="Ayuda sobre el flujo de abasto">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE897;" FontSize="18" />
                        <TextBlock Text="Ayuda" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Height="1" Margin="4,8" Background="{StaticResource StitchBorderBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="10" Padding="8,4" ToolTipService.ToolTip="{x:Bind ViewModel.UserDisplayName, Mode=OneWay}">
                    <Border Width="32" Height="32" CornerRadius="4" Background="{StaticResource StitchBlackBrush}">
                        <TextBlock Text="{x:Bind ViewModel.UserInitials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="0" MaxWidth="138">
                        <TextBlock Text="{x:Bind ViewModel.UserDisplayName}" MaxLines="1" TextTrimming="CharacterEllipsis" Style="{StaticResource GuardianStrongTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.UserSubtitle}" MaxLines="1" TextTrimming="CharacterEllipsis" Style="{StaticResource GuardianEyebrowTextStyle}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </NavigationView.PaneFooter>

        <NavigationView.Header>
            <Border Height="72" Background="{StaticResource StitchSurfaceBrush}" BorderBrush="{StaticResource StitchBorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="16" Padding="28,0,18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                Text="{x:Bind ViewModel.SectionTitle, Mode=OneWay}"
                                FontFamily="{StaticResource GuardianDisplayFontFamily}"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="{StaticResource StitchTextPrimaryBrush}" />
                            <Border
                                MinHeight="18"
                                VerticalAlignment="Center"
                                Background="{StaticResource StitchPrimarySoftBrush}"
                                CornerRadius="4"
                                Padding="7,2"
                                Visibility="{x:Bind ViewModel.TransferHeaderBadgeVisibility, Mode=OneWay}">
                                <TextBlock
                                    Text="REABASTECIMIENTO OPERATIVO"
                                    FontSize="9"
                                    FontWeight="Bold"
                                    CharacterSpacing="40"
                                    Foreground="{StaticResource StitchPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind ViewModel.SectionSubtitle, Mode=OneWay}"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="{StaticResource StitchTextMutedBrush}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <Border Height="34" Background="{StaticResource StitchSurfaceSubtleBrush}" BorderBrush="{StaticResource StitchBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="3">
                            <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                                <Button
                                    Tag="EPA"
                                    Click="SelectCompany_Click"
                                    MinHeight="0"
                                    Background="{x:Bind ViewModel.IsCompanyEpa, Mode=OneWay, Converter={StaticResource SegmentTabBackgroundBrushConverter}}"
                                    BorderThickness="0"
                                    Padding="14,5"
                                    CornerRadius="5">
                                    <TextBlock Text="EPA" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{x:Bind ViewModel.IsCompanyEpa, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                                </Button>
                                <Button
                                    Tag="Cofersa"
                                    Click="SelectCompany_Click"
                                    MinHeight="0"
                                    Background="{x:Bind ViewModel.IsCompanyCofersa, Mode=OneWay, Converter={StaticResource SegmentTabBackgroundBrushConverter}}"
                                    BorderThickness="0"
                                    Padding="14,5"
                                    CornerRadius="5">
                                    <TextBlock Text="Cofersa" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{x:Bind ViewModel.IsCompanyCofersa, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Width="1" Height="24" Background="{StaticResource StitchBorderBrush}" />
                        <Button
                            Width="34"
                            Height="34"
                            Padding="0"
                            Command="{x:Bind ViewModel.AnalyzeCommand}"
                            Background="{StaticResource StitchSurfaceBrush}"
                            BorderBrush="{StaticResource StitchBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            ToolTipService.ToolTip="Actualizar analisis">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" FontSize="15" Foreground="{StaticResource StitchTextMutedBrush}" />
                        </Button>
                        <Button
                            Width="34"
                            Height="34"
                            Padding="0"
                            Background="{StaticResource StitchSurfaceBrush}"
                            BorderBrush="{StaticResource StitchBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            ToolTipService.ToolTip="Notificaciones">
                            <Grid>
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xEA8F;" FontSize="15" Foreground="{StaticResource StitchTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse Width="7" Height="7" Fill="{StaticResource StitchDangerBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </NavigationView.Header>

        <Grid
            x:Name="RootGrid"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Padding="24,24,24,24"
            RowSpacing="12">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="ModuleSurfaceTransform" />
            </Grid.RenderTransform>
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="16" />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.ChildrenTransitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            Visibility="{x:Bind ViewModel.LoadPanelVisibility, Mode=OneWay}"
            Style="{StaticResource StitchPanelBorderStyle}"
            Padding="14">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="LoadControlsGrid"
                    Grid.Row="0"
                    ColumnSpacing="8"
                    RowSpacing="8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    SizeChanged="LoadControlsGrid_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="LoadRow0" Height="Auto" />
                        <RowDefinition x:Name="LoadRow1" Height="0" />
                        <RowDefinition x:Name="LoadRow2" Height="0" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LoadCol0" Width="Auto" />
                        <ColumnDefinition x:Name="LoadCol1" Width="Auto" />
                        <ColumnDefinition x:Name="LoadCol2" Width="Auto" />
                        <ColumnDefinition x:Name="LoadCol3" Width="Auto" />
                        <ColumnDefinition x:Name="LoadCol4" Width="Auto" />
                        <ColumnDefinition x:Name="LoadCol5" Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="LoadInventoryButton"
                        Grid.Column="0"
                        MinWidth="136"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.LoadInventoryCommand}"
                        ToolTipService.ToolTip="Cargar inventario solo para el modulo activo"
                        Style="{StaticResource GuardianSecondaryButtonStyle}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE898;" FontSize="16" Foreground="{StaticResource StitchPrimaryBrush}" />
                            <TextBlock Grid.Column="1" Text="Cargar Inventario" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        </Grid>
                    </Button>

                    <Button
                        x:Name="LoadForecastButton"
                        Grid.Column="1"
                        MinWidth="132"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.LoadForecastCommand}"
                        ToolTipService.ToolTip="Cargar forecast solo para el modulo activo"
                        Style="{StaticResource GuardianSecondaryButtonStyle}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE9D2;" FontSize="16" Foreground="{StaticResource StitchPrimaryBrush}" />
                            <TextBlock Grid.Column="1" Text="Cargar Forecast" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        </Grid>
                    </Button>

                    <Border
                        x:Name="AnalysisPeriodSelector"
                        Grid.Column="2"
                        Height="36"
                        MinWidth="190"
                        MaxWidth="320"
                        HorizontalAlignment="Left"
                        Background="{StaticResource StitchSurfaceSubtleBrush}"
                        BorderBrush="{StaticResource StitchBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,0"
                        Visibility="{x:Bind ViewModel.AnalysisPeriodControlsVisibility, Mode=OneWay}"
                        VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="SEMANA:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource StitchTextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <ComboBox
                                MinWidth="126"
                                HorizontalAlignment="Stretch"
                                MinHeight="30"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                DisplayMemberPath="Label"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource StitchTextPrimaryBrush}"
                                ItemsSource="{x:Bind ViewModel.AvailableWeeks, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedWeek, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="HorizonSelector"
                        Grid.Column="3"
                        Height="36"
                        MinWidth="170"
                        MaxWidth="280"
                        HorizontalAlignment="Left"
                        Background="{StaticResource StitchSurfaceSubtleBrush}"
                        BorderBrush="{StaticResource StitchBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,0"
                        Visibility="{x:Bind ViewModel.HorizonControlsVisibility, Mode=OneWay}"
                        VerticalAlignment="Bottom"
                        ToolTipService.ToolTip="Desde la semana elegida: 4 o 5 semanas, o 1/2/3 meses corridos"
                        >
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="HORIZONTE:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource StitchTextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <ComboBox
                                MinWidth="106"
                                HorizontalAlignment="Stretch"
                                MinHeight="30"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                DisplayMemberPath="Label"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource StitchTextPrimaryBrush}"
                                ItemsSource="{x:Bind ViewModel.HorizonOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedHorizon, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <Button
                        x:Name="MoreLoadActionsButton"
                        Grid.Column="4"
                        Width="38"
                        Height="36"
                        Padding="0"
                        VerticalAlignment="Bottom"
                        Visibility="{x:Bind ViewModel.NonComparisonLoadControlsVisibility, Mode=OneWay}"
                        ToolTipService.ToolTip="Mas herramientas"
                        Style="{StaticResource GuardianSecondaryButtonStyle}">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE712;" FontSize="16" Foreground="{StaticResource StitchTextMutedBrush}" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Exportar analisis" Command="{x:Bind ViewModel.ExportCommand}" />
                                <MenuFlyoutItem Text="Alistado satelital" Command="{x:Bind ViewModel.LoadPreparedArticlesCommand}" />
                                <MenuFlyoutItem Text="Tamanos de tarima" Command="{x:Bind ViewModel.LoadTarimaSizesCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <ProgressRing
                        x:Name="LoadProgressRing"
                        Grid.Column="5"
                        Width="28"
                        Height="28"
                        VerticalAlignment="Bottom"
                        Foreground="{ThemeResource GuardianPrimaryBrush}"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </Grid>

                <Border
                    Grid.Row="1"
                    HorizontalAlignment="Left"
                    Background="{StaticResource StitchSurfaceSubtleBrush}"
                    BorderBrush="{StaticResource StitchBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource StitchPrimaryBrush}" />
                        <TextBlock Text="Listo:" FontSize="12" FontWeight="Bold" Foreground="{StaticResource StitchPrimaryBrush}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.LoadSummaryText, Mode=OneWay}"
                            FontSize="12"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{StaticResource StitchTextMutedBrush}" />
                        <TextBlock Text="•" FontSize="12" Foreground="{StaticResource StitchBorderBrush}" />
                        <TextBlock Text="Último cálculo:" FontSize="12" Foreground="{StaticResource StitchTextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.LastCalculationText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource StitchTextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid
            x:Name="MainContentGrid"
            Grid.Row="1"
            MinHeight="0"
            ColumnSpacing="18"
            RowSpacing="16"
            Visibility="{x:Bind ViewModel.TableViewVisibility, Mode=OneWay}"
            SizeChanged="MainContentGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MainCol0" Width="1.9*" />
                <ColumnDefinition x:Name="MainCol1" Width="1.1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="MainRow0" Height="*" />
                <RowDefinition x:Name="MainRow1" Height="0" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Grid.Column="0"
                Style="{StaticResource GuardianCardBorderStyle}">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Text="COBERTURA PRINCIPAL"
                        Style="{StaticResource GuardianEyebrowTextStyle}" />

                    <Grid
                        Grid.Row="1"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Background="{ThemeResource GuardianInfoLowBrush}"
                            BorderBrush="{ThemeResource GuardianBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="ARTICULOS"
                                    Style="{StaticResource GuardianEyebrowTextStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.TotalArticles, Mode=OneWay}"
                                    FontSize="24"
                                    Style="{StaticResource GuardianStrongTextStyle}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Background="{ThemeResource GuardianDangerLowBrush}"
                            BorderBrush="{ThemeResource GuardianDangerBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,10">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    Text="ROJO"
                                    Style="{StaticResource GuardianEyebrowTextStyle}"
                                    Foreground="{ThemeResource GuardianDangerBrush}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.CriticalCount, Mode=OneWay}"
                                    FontSize="24"
                                    Style="{StaticResource GuardianStrongTextStyle}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="2"
                            Background="{ThemeResource GuardianWarningLowBrush}"
                            BorderBrush="{ThemeResource GuardianWarningBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,10">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    Text="AMARILLO"
                                    Style="{StaticResource GuardianEyebrowTextStyle}"
                                    Foreground="{ThemeResource GuardianWarningBrush}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.WarningCount, Mode=OneWay}"
                                    FontSize="24"
                                    Style="{StaticResource GuardianStrongTextStyle}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="3"
                            Background="{ThemeResource GuardianSuccessLowBrush}"
                            BorderBrush="{ThemeResource GuardianSuccessBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,10">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    Text="VERDE"
                                    Style="{StaticResource GuardianEyebrowTextStyle}"
                                    Foreground="{ThemeResource GuardianSuccessBrush}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.HealthyCount, Mode=OneWay}"
                                    FontSize="24"
                                    Style="{StaticResource GuardianStrongTextStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock
                        Grid.Row="2"
                        Text="Articulos evaluados"
                        VerticalAlignment="Center"
                        Style="{StaticResource GuardianStrongTextStyle}" />

                    <Grid Grid.Row="3">
                        <Button
                            HorizontalAlignment="Right"
                            MinWidth="120"
                            Command="{x:Bind ViewModel.ClearFiltersCommand}"
                            Content="Limpiar filtros"
                            ToolTipService.ToolTip="Quitar todos los filtros de columna"
                            Style="{StaticResource GuardianSecondaryButtonStyle}" />
                    </Grid>

                    <Grid
                        Grid.Row="4"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="0.85*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="0.9*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Padding="4,2"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Articulo / descripcion" VerticalAlignment="Center" Style="{StaticResource GuardianStrongTextStyle}" />
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="11" Foreground="{x:Bind ViewModel.ArticleFilterActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar articulo" PlaceholderText="Buscar articulo o descripcion" PanelWidth="300" Filter="{x:Bind ViewModel.TableArticuloFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button
                            Grid.Column="1"
                            Padding="4,2"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.ForecastColumnHeader, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource GuardianStrongTextStyle}" />
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="11" Foreground="{x:Bind ViewModel.ForecastFilterActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar forecast" PlaceholderText="Buscar forecast" PanelWidth="300" Filter="{x:Bind ViewModel.TableForecastFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button
                            Grid.Column="2"
                            Padding="4,2"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Principal" VerticalAlignment="Center" Style="{StaticResource GuardianStrongTextStyle}" />
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="11" Foreground="{x:Bind ViewModel.PrincipalFilterActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar principal" PlaceholderText="Buscar principal" PanelWidth="300" Filter="{x:Bind ViewModel.TablePrincipalFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button
                            Grid.Column="3"
                            Padding="4,2"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Dif. Pr." VerticalAlignment="Center" Style="{StaticResource GuardianStrongTextStyle}" />
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="11" Foreground="{x:Bind ViewModel.DiffFilterActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar diferencia" PlaceholderText="Buscar diferencia" PanelWidth="300" Filter="{x:Bind ViewModel.TableDifferenceFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button
                            Grid.Column="4"
                            Padding="4,2"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Estado Pr." VerticalAlignment="Center" Style="{StaticResource GuardianStrongTextStyle}" />
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="11" Foreground="{x:Bind ViewModel.StatusFilterActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar estado" PlaceholderText="Buscar estado" PanelWidth="260" Filter="{x:Bind ViewModel.TableStatusFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button
                            Grid.Column="5"
                            Padding="4,2"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Sat." VerticalAlignment="Center" Style="{StaticResource GuardianStrongTextStyle}" />
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="11" Foreground="{x:Bind ViewModel.SatFilterActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar satelite" PlaceholderText="Buscar satelite" PanelWidth="300" Filter="{x:Bind ViewModel.TableSatelliteFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <ListView
                        Grid.Row="5"
                        MinHeight="0"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource GuardianListViewItemStyle}"
                        ItemsSource="{x:Bind ViewModel.FilteredResults, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedArticle, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ArticleResultRowViewModel">
                                <Border
                                    Background="{ThemeResource GuardianBgElevatedBrush}"
                                    BorderBrush="{ThemeResource GuardianBorderSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10,8">
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Copiar fila" Click="CopyRow_Click" />
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="0.85*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="0.9*" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Background="{x:Bind StatusAccentBrush}"
                                            CornerRadius="20" />

                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Spacing="3">
                                            <TextBlock
                                                Text="{x:Bind Article}"
                                                MaxLines="1"
                                                TextTrimming="CharacterEllipsis"
                                                Style="{StaticResource GuardianStrongTextStyle}" />
                                            <TextBlock
                                                Text="{x:Bind Description}"
                                                MaxLines="1"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="{ThemeResource GuardianTextSecondaryBrush}" />
                                            <TextBlock
                                                Text="{x:Bind ZoneSummaryText}"
                                                Style="{StaticResource GuardianEyebrowTextStyle}"
                                                Foreground="{ThemeResource GuardianTextSecondaryBrush}" />
                                            <TextBlock
                                                Text="{x:Bind TransferInstructionText}"
                                                Visibility="{x:Bind TransferInstructionVisibility}"
                                                Foreground="{x:Bind TransferAccentBrush}"
                                                TextWrapping="Wrap"
                                                MaxLines="2"
                                                Style="{StaticResource GuardianEyebrowTextStyle}" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind ForecastText}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource GuardianMonoTextStyle}" />

                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{x:Bind PrincipalInventoryText}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource GuardianMonoTextStyle}" />

                                        <TextBlock
                                            Grid.Column="4"
                                            Text="{x:Bind DifferenceText}"
                                            Foreground="{x:Bind GeneralAccentBrush}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource GuardianMonoTextStyle}" />

                                        <Border
                                            Grid.Column="5"
                                            Background="{x:Bind GeneralPillBrush}"
                                            BorderBrush="{x:Bind GeneralBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="18"
                                            Padding="10,4"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind StatusLabel}"
                                                Foreground="{x:Bind GeneralAccentBrush}"
                                                Style="{StaticResource GuardianEyebrowTextStyle}" />
                                        </Border>

                                        <TextBlock
                                            Grid.Column="6"
                                            Text="{x:Bind SatelliteInventoryText}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource GuardianMonoTextStyle}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid
                x:Name="DetailColumnPanel"
                Grid.Row="0"
                Grid.Column="1"
                MinHeight="0"
                RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    Background="{ThemeResource GuardianBgElevatedBrush}"
                    BorderBrush="{ThemeResource GuardianBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Foreground="{ThemeResource GuardianTextPrimaryBrush}"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.IsMessageOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.MessageText, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
                    Title="{x:Bind ViewModel.MessageTitle, Mode=OneWay}" />

                <Border
                    Grid.Row="1"
                    Style="{StaticResource GuardianCardBorderStyle}">
                    <Grid
                        MinHeight="0"
                        RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Text="STOCK Y TRASLADO"
                            Style="{StaticResource GuardianEyebrowTextStyle}" />
                        <TextBlock
                            Grid.Row="1"
                            Text="{x:Bind ViewModel.DetailTitle, Mode=OneWay}"
                            Style="{StaticResource GuardianStrongTextStyle}" />

                        <Grid
                            Grid.Row="2"
                            MinHeight="0"
                            RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="10" RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Background="{ThemeResource GuardianPrimaryLowBrush}"
                                    BorderBrush="{ThemeResource GuardianBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="{x:Bind ViewModel.ForecastHeaderCaption, Mode=OneWay}"
                                            Style="{StaticResource GuardianEyebrowTextStyle}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.DetailForecastText, Mode=OneWay}"
                                            Style="{StaticResource GuardianMonoTextStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Background="{ThemeResource GuardianInfoLowBrush}"
                                    BorderBrush="{ThemeResource GuardianBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="PRINCIPAL"
                                            Style="{StaticResource GuardianEyebrowTextStyle}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.DetailPrincipalInventoryText, Mode=OneWay}"
                                            Style="{StaticResource GuardianMonoTextStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Row="1"
                                    Background="{ThemeResource GuardianSuccessLowBrush}"
                                    BorderBrush="{ThemeResource GuardianSuccessBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="SATELITAL"
                                            Style="{StaticResource GuardianEyebrowTextStyle}"
                                            Foreground="{ThemeResource GuardianSuccessBrush}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.DetailSatelliteInventoryText, Mode=OneWay}"
                                            Style="{StaticResource GuardianMonoTextStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Background="{ThemeResource GuardianPrimaryLowBrush}"
                                    BorderBrush="{ThemeResource GuardianBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="TOTAL"
                                            Style="{StaticResource GuardianEyebrowTextStyle}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.DetailTotalInventoryText, Mode=OneWay}"
                                            Style="{StaticResource GuardianMonoTextStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Row="2"
                                    Background="{ThemeResource GuardianWarningLowBrush}"
                                    BorderBrush="{ThemeResource GuardianWarningBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="TRASLADO"
                                            Style="{StaticResource GuardianEyebrowTextStyle}"
                                            Foreground="{ThemeResource GuardianWarningBrush}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.DetailTransferSuggestionText, Mode=OneWay}"
                                            Style="{StaticResource GuardianMonoTextStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Background="{ThemeResource GuardianDangerLowBrush}"
                                    BorderBrush="{ThemeResource GuardianDangerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="PENDIENTE"
                                            Style="{StaticResource GuardianEyebrowTextStyle}"
                                            Foreground="{ThemeResource GuardianDangerBrush}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.DetailRemainingShortageText, Mode=OneWay}"
                                            Style="{StaticResource GuardianMonoTextStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid
                                Grid.Row="1"
                                MinHeight="0"
                                RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Text="{x:Bind ViewModel.DetailTransferStateText, Mode=OneWay}"
                                    Style="{StaticResource GuardianEyebrowTextStyle}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Text="{x:Bind ViewModel.DetailSubtitle, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Style="{StaticResource GuardianBodyTextStyle}" />

                                <ListView
                                    Grid.Row="2"
                                    MinHeight="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemContainerStyle="{StaticResource GuardianListViewItemStyle}"
                                    ItemsSource="{x:Bind ViewModel.ZoneDetails, Mode=OneWay}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:ZoneDetailRowViewModel">
                                            <Border
                                                Background="{ThemeResource GuardianBgElevatedBrush}"
                                                BorderBrush="{ThemeResource GuardianBorderSoftBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="12">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Text="{x:Bind StorageZone}"
                                                        TextWrapping="Wrap"
                                                        Style="{StaticResource GuardianBodyTextStyle}" />
                                                    <Border
                                                        Grid.Column="1"
                                                        Background="{x:Bind ZoneTypeBackgroundBrush}"
                                                        BorderBrush="{x:Bind ZoneTypeBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="18"
                                                        Padding="10,4">
                                                        <TextBlock
                                                            Text="{x:Bind ZoneTypeLabel}"
                                                            Foreground="{x:Bind ZoneTypeAccentBrush}"
                                                            Style="{StaticResource GuardianEyebrowTextStyle}" />
                                                    </Border>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Text="{x:Bind QuantityText}"
                                                        Style="{StaticResource GuardianMonoTextStyle}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid
            Grid.Row="1"
            Visibility="{x:Bind ViewModel.TransferViewVisibility, Mode=OneWay}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                <Button
                    HorizontalAlignment="Right"
                    MinHeight="30"
                    Padding="10,4"
                    Command="{x:Bind ViewModel.ToggleOperationsPanelCommand}"
                    ToolTipService.ToolTip="Ocultar o mostrar carga y resumen superior"
                    Style="{StaticResource GuardianSecondaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="{x:Bind ViewModel.OperationsPanelToggleGlyph, Mode=OneWay}" FontSize="12" Foreground="{StaticResource StitchPrimaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.OperationsPanelToggleText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Funnel cards -->
            <Grid
                x:Name="TransferMetricCardsGrid"
                Grid.Row="1"
                ColumnSpacing="16"
                RowSpacing="12"
                HorizontalAlignment="Stretch"
                Visibility="{x:Bind ViewModel.TransferOperationsPanelVisibility, Mode=OneWay}"
                SizeChanged="MetricCardsGrid_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TransferMetricRow0" Height="Auto" />
                    <RowDefinition x:Name="TransferMetricRow1" Height="0" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TransferMetricCol0" Width="*" />
                    <ColumnDefinition x:Name="TransferMetricCol1" Width="*" />
                    <ColumnDefinition x:Name="TransferMetricCol2" Width="*" />
                    <ColumnDefinition x:Name="TransferMetricCol3" Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="TransferMetricEvaluated" MinWidth="180" MinHeight="112" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource StitchMetricCardStyle}">
                    <StackPanel Spacing="8" VerticalAlignment="Stretch">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="1. EVALUADOS" TextTrimming="CharacterEllipsis" MaxLines="1" Foreground="{StaticResource StitchTextMutedBrush}" Style="{StaticResource GuardianEyebrowTextStyle}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Border Background="{StaticResource StitchProgressTrackBrush}" CornerRadius="4" Padding="8,2">
                                    <TextBlock Text="Catalogo activo" TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource StitchTextMutedBrush}" />
                                </Border>
                                <Border Width="18" Height="18" VerticalAlignment="Center">
                                    <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform">
                                        <Path Width="24" Height="24" Stretch="Uniform" Fill="{StaticResource StitchTextMutedBrush}" Data="M4 5 H6 V7 H4 Z M8 5 H20 V7 H8 Z M4 11 H6 V13 H4 Z M8 11 H20 V13 H8 Z M4 17 H6 V19 H4 Z M8 17 H20 V19 H8 Z M2 5 H3 V7 H2 Z M2 11 H3 V13 H2 Z M2 17 H3 V19 H2 Z" />
                                    </Viewbox>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="2" Margin="0,2,0,0">
                            <TextBlock Text="{x:Bind ViewModel.FunnelEvaluated, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1" FontFamily="{StaticResource GuardianDisplayFontFamily}" FontSize="28" FontWeight="ExtraBold" Foreground="{StaticResource StitchTextPrimaryBrush}" />
                            <TextBlock Text="SKUs analizados" TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="12" FontWeight="Medium" Foreground="{StaticResource StitchTextMutedBrush}" />
                        </StackPanel>
                        <ProgressBar Value="100" Maximum="100" Height="6" Foreground="{StaticResource StitchTextSoftBrush}" Background="{StaticResource StitchProgressTrackBrush}" />
                    </StackPanel>
                </Border>

                <Border x:Name="TransferMetricCovered" Grid.Column="1" MinWidth="180" MinHeight="112" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource StitchMetricCardStyle}">
                    <StackPanel Spacing="8" VerticalAlignment="Stretch">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="2. ALCANZAN" TextTrimming="CharacterEllipsis" MaxLines="1" Foreground="{StaticResource StitchTextMutedBrush}" Style="{StaticResource GuardianEyebrowTextStyle}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Border Background="{StaticResource StitchPrimarySurfaceBrush}" CornerRadius="4" Padding="8,2">
                                    <TextBlock Text="{x:Bind ViewModel.FunnelCoveredPercentText, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource StitchPrimaryBrush}" />
                                </Border>
                                <Border Width="18" Height="18" VerticalAlignment="Center">
                                    <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform">
                                        <Path Width="24" Height="24" Stretch="Uniform" Fill="{StaticResource StitchPrimaryBrush}" Data="M3 20 H21 V10 L12 4 L3 10 Z M5 18 V11.2 L12 6.8 L19 11.2 V18 H16 V13 H8 V18 Z M10 18 V15 H14 V18 Z" />
                                    </Viewbox>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="2" Margin="0,2,0,0">
                            <TextBlock Text="{x:Bind ViewModel.FunnelCovered, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1" FontFamily="{StaticResource GuardianDisplayFontFamily}" FontSize="28" FontWeight="ExtraBold" Foreground="{StaticResource StitchTextPrimaryBrush}" />
                            <TextBlock Text="Cubiertos en principal" TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="12" FontWeight="Medium" Foreground="{StaticResource StitchTextMutedBrush}" />
                        </StackPanel>
                        <ProgressBar Value="{x:Bind ViewModel.FunnelCovered, Mode=OneWay}" Maximum="{x:Bind ViewModel.FunnelEvaluated, Mode=OneWay}" Height="6" Foreground="{StaticResource StitchPrimaryBrush}" Background="{StaticResource StitchProgressTrackBrush}" />
                    </StackPanel>
                </Border>

                <Border x:Name="TransferMetricToTransfer" Grid.Column="2" MinWidth="180" MinHeight="112" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource StitchPrimaryMetricCardStyle}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFF" Offset="0" />
                            <GradientStop Color="#F0FAF8" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid RowSpacing="4" ColumnSpacing="8" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="3.&#x0a;TRASLADOS" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" Foreground="{StaticResource StitchPrimaryBrush}" Style="{StaticResource GuardianEyebrowTextStyle}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Border Background="{StaticResource StitchPrimaryBrush}" CornerRadius="4" Padding="8,2">
                                <TextBlock Text="ACCION PRIORITARIA" TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="10" FontWeight="Bold" Foreground="White" />
                            </Border>
                            <Border Width="18" Height="18" VerticalAlignment="Center">
                                <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform">
                                    <Path Width="24" Height="24" Stretch="Uniform" Fill="{StaticResource StitchPrimaryBrush}" Data="M3 17 H4.5 C4.8 15.9 5.8 15 7 15 C8.2 15 9.2 15.9 9.5 17 H13 V7 H15 V17 H17 V5 H19 V17 H21 V19 H19.7 C19.4 20.1 18.4 21 17.2 21 C16 21 15 20.1 14.7 19 H9.5 C9.2 20.1 8.2 21 7 21 C5.8 21 4.8 20.1 4.5 19 H3 Z M5.8 17 H8.2 C8 16.4 7.5 16 7 16 C6.5 16 6 16.4 5.8 17 Z M16 17 H18.4 C18.2 16.4 17.7 16 17.2 16 C16.7 16 16.2 16.4 16 17 Z M5 9 H11 V14 H5 Z M7 11 V12 H9 V11 Z" />
                                </Viewbox>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="2" Margin="0,2,0,0">
                            <TextBlock Text="{x:Bind ViewModel.FunnelToTransfer, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1" FontFamily="{StaticResource GuardianDisplayFontFamily}" FontSize="28" FontWeight="ExtraBold" Foreground="{StaticResource StitchPrimaryBrush}" />
                            <TextBlock Text="SKUs a trasladar urgente" TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource StitchTextPrimaryBrush}" />
                        </StackPanel>
                        <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,0" Value="{x:Bind ViewModel.FunnelToTransferProgress, Mode=OneWay}" Maximum="100" Height="6" Foreground="{StaticResource StitchPrimaryBrush}" Background="{StaticResource StitchPrimaryBorderBrush}" />
                    </Grid>
                </Border>

                <Border x:Name="TransferMetricWithoutExternal" Grid.Column="3" MinWidth="180" MinHeight="112" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource StitchMetricCardStyle}">
                    <StackPanel Spacing="8" VerticalAlignment="Stretch">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="4. SIN BODEGA EXT." TextTrimming="CharacterEllipsis" MaxLines="1" Foreground="{StaticResource StitchTextMutedBrush}" Style="{StaticResource GuardianEyebrowTextStyle}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Border Background="{StaticResource StitchDangerSoftBrush}" CornerRadius="4" Padding="8,2">
                                    <TextBlock Text="Ruptura / OC" TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource StitchDangerBrush}" />
                                </Border>
                                <Border Width="18" Height="18" VerticalAlignment="Center">
                                    <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform">
                                        <Path Width="24" Height="24" Stretch="Uniform" Fill="{StaticResource StitchDangerBrush}" Data="M12 2 L22 20 H2 Z M11 9 H13 V14 H11 Z M11 16 H13 V18 H11 Z" />
                                    </Viewbox>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="2" Margin="0,2,0,0">
                            <TextBlock Text="{x:Bind ViewModel.FunnelWithoutExternal, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1" FontFamily="{StaticResource GuardianDisplayFontFamily}" FontSize="28" FontWeight="ExtraBold" Foreground="{StaticResource StitchDangerBrush}" />
                            <TextBlock Text="SKUs sin stock externo" TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="12" FontWeight="Medium" Foreground="{StaticResource StitchTextMutedBrush}" />
                        </StackPanel>
                        <ProgressBar Value="{x:Bind ViewModel.FunnelWithoutExternal, Mode=OneWay}" Maximum="{x:Bind ViewModel.FunnelEvaluated, Mode=OneWay}" Height="6" Foreground="{StaticResource StitchDangerBrush}" Background="{StaticResource StitchProgressTrackBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource StitchPanelBorderStyle}" Padding="14">
                <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Background="{StaticResource StitchProgressTrackBrush}"
                        CornerRadius="8"
                        Padding="4">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Tag="Todos" Click="TransferTab_Click" Padding="12,6" CornerRadius="6" BorderThickness="0"
                                    Background="{x:Bind ViewModel.IsTabTodos, Mode=OneWay, Converter={StaticResource SegmentTabBackgroundBrushConverter}}"
                                    Foreground="{x:Bind ViewModel.IsTabTodos, Mode=OneWay, Converter={StaticResource SegmentTabForegroundBrushConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Todos" />
                                    <StackPanel Orientation="Horizontal" Spacing="0">
                                        <TextBlock Text="(" Foreground="{StaticResource StitchTextSoftBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.TransferAllTabCountText, Mode=OneWay}" Foreground="{StaticResource StitchTextSoftBrush}" />
                                        <TextBlock Text=")" Foreground="{StaticResource StitchTextSoftBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Tag="ParaTraer" Click="TransferTab_Click" Padding="12,6" CornerRadius="6" BorderThickness="0"
                                    Background="{x:Bind ViewModel.IsTabParaTraer, Mode=OneWay, Converter={StaticResource SegmentTabBackgroundBrushConverter}}"
                                    Foreground="{x:Bind ViewModel.IsTabParaTraer, Mode=OneWay, Converter={StaticResource SegmentTabForegroundBrushConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="Para traer" FontWeight="Bold" />
                                    <Border Background="{StaticResource StitchPrimarySoftBrush}" CornerRadius="3" Padding="6,1">
                                        <TextBlock Text="{x:Bind ViewModel.TransferToBringTabCountText, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource StitchPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button Tag="Criticos" Click="TransferTab_Click" Padding="12,6" CornerRadius="6" BorderThickness="0"
                                    Background="{x:Bind ViewModel.IsTabCriticos, Mode=OneWay, Converter={StaticResource SegmentTabBackgroundBrushConverter}}"
                                    Foreground="{x:Bind ViewModel.IsTabCriticos, Mode=OneWay, Converter={StaticResource SegmentTabForegroundBrushConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Criticos" />
                                    <StackPanel Orientation="Horizontal" Spacing="0">
                                        <TextBlock Text="(" FontWeight="SemiBold" Foreground="{StaticResource StitchDangerBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.TransferCriticalTabCountText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource StitchDangerBrush}" />
                                        <TextBlock Text=")" FontWeight="SemiBold" Foreground="{StaticResource StitchDangerBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Tag="AlistadoSatelital" Click="TransferTab_Click" Padding="12,6" CornerRadius="6" BorderThickness="0"
                                    Background="{x:Bind ViewModel.IsTabAlistadoSatelital, Mode=OneWay, Converter={StaticResource SegmentTabBackgroundBrushConverter}}"
                                    Foreground="{x:Bind ViewModel.IsTabAlistadoSatelital, Mode=OneWay, Converter={StaticResource SegmentTabForegroundBrushConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Alistado Sat." />
                                    <StackPanel Orientation="Horizontal" Spacing="0">
                                        <TextBlock Text="(" Foreground="{StaticResource StitchTextMutedBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.TransferPreparedTabCountText, Mode=OneWay}" Foreground="{StaticResource StitchTextMutedBrush}" />
                                        <TextBlock Text=")" Foreground="{StaticResource StitchTextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Column="1" ColumnSpacing="8" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:ModuleSearchBox
                            x:Name="TransferSearchBox"
                            VerticalAlignment="Center"
                            PlaceholderText="Buscar SKU, descripción, pallet o zona..."
                            Text="{x:Bind ViewModel.TransferSearchText, Mode=TwoWay}"
                            Summary="{x:Bind ViewModel.TransferSearchSummary, Mode=OneWay}"
                            SubmitCommand="{x:Bind ViewModel.SubmitSearchCommand}" />
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.ExportRequisitionCommand}" Style="{StaticResource GuardianSecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE896;" FontSize="15" Foreground="{StaticResource StitchTextMutedBrush}" />
                                <TextBlock Text="Exportar CSV" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Command="{x:Bind ViewModel.SendSelectedToTransitCommand}" Style="{StaticResource GuardianPrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE724;" FontSize="15" Foreground="{ThemeResource GuardianOnPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SendSelectedToTransitButtonText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Data grid card -->
            <Border Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource StitchPanelBorderStyle}" Padding="0">
                <SplitView
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    CompactPaneLength="0"
                    DisplayMode="Overlay"
                    IsPaneOpen="False"
                    OpenPaneLength="0"
                    PanePlacement="Right">
                    <SplitView.Pane>
                        <Border
                            Width="390"
                            Padding="16"
                            Background="{StaticResource StitchSurfaceBrush}"
                            BorderBrush="{StaticResource StitchBorderBrush}"
                            BorderThickness="1,0,0,0"
                            DataContext="{x:Bind ViewModel.SelectedTransferRow, Mode=OneWay}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Palets a traer" Style="{StaticResource GuardianStrongTextStyle}" />
                                        <TextBlock Text="{Binding ArticleDescriptionText}" TextWrapping="Wrap" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="CloseTransferPalletPane_Click" Width="32" Height="32" Padding="0" Style="{StaticResource GuardianSecondaryButtonStyle}">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="12" Foreground="{StaticResource StitchTextPrimaryBrush}" />
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="1" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Padding="10,8" Background="{StaticResource StitchPrimarySoftBrush}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Cantidad" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                            <TextBlock Text="{Binding TransferSuggestionText}" Style="{StaticResource GuardianStrongTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Padding="10,8" Background="{StaticResource StitchPrimarySoftBrush}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Palets" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                            <TextBlock Text="{Binding SuggestedPalletCountText}" Style="{StaticResource GuardianStrongTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Padding="10,8" Background="{StaticResource StitchPrimarySoftBrush}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Sobrante" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                            <TextBlock Text="{Binding PalletRoundUpSurplusText}" Style="{StaticResource GuardianStrongTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <ListView
                                    Grid.Row="2"
                                    MinHeight="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemContainerStyle="{StaticResource GuardianListViewItemStyle}"
                                    ItemsSource="{Binding PalletOptions}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:PalletSelectionViewModel">
                                            <Grid Padding="0,8" ColumnSpacing="10" BorderBrush="{StaticResource StitchBorderBrush}" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="68" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" VerticalAlignment="Top" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="{x:Bind Pallet}" IsTextSelectionEnabled="True" Style="{StaticResource GuardianMonoTextStyle}" />
                                                    <TextBlock Text="{x:Bind Location}" TextWrapping="Wrap" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                                    <TextBlock Text="{x:Bind StorageZone}" TextWrapping="Wrap" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind ValidationDateText}" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                                        <TextBlock Text="{x:Bind Origin}" Style="{StaticResource GuardianStrongTextStyle}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{x:Bind QuantityText}" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource GuardianMonoTextStyle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </SplitView.Pane>

                <Grid MinHeight="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="14,12" ColumnSpacing="12" BorderBrush="{StaticResource StitchBorderBrush}" BorderThickness="0,0,0,1" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="{StaticResource StitchSurfaceSubtleBrush}"
                            BorderBrush="{StaticResource StitchBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="3">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Tag="Todos" Click="TransferTab_Click" Padding="12,6" CornerRadius="6" BorderThickness="0"
                                        Background="{x:Bind ViewModel.IsTabTodos, Mode=OneWay, Converter={StaticResource SegmentTabBackgroundBrushConverter}}"
                                        Foreground="{x:Bind ViewModel.IsTabTodos, Mode=OneWay, Converter={StaticResource SegmentTabForegroundBrushConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Todos" />
                                        <TextBlock Text="{x:Bind ViewModel.TransferAllTabCountText, Mode=OneWay}" Foreground="{StaticResource StitchTextSoftBrush}" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="ParaTraer" Click="TransferTab_Click" Padding="12,6" CornerRadius="6" BorderThickness="0"
                                        Background="{x:Bind ViewModel.IsTabParaTraer, Mode=OneWay, Converter={StaticResource SegmentTabBackgroundBrushConverter}}"
                                        Foreground="{x:Bind ViewModel.IsTabParaTraer, Mode=OneWay, Converter={StaticResource SegmentTabForegroundBrushConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="Para traer" />
                                        <Border Background="{StaticResource StitchPrimarySoftBrush}" CornerRadius="3" Padding="5,0">
                                            <TextBlock Text="{x:Bind ViewModel.TransferToBringTabCountText, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource StitchPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                                <Button Tag="Criticos" Click="TransferTab_Click" Padding="12,6" CornerRadius="6" BorderThickness="0"
                                        Background="{x:Bind ViewModel.IsTabCriticos, Mode=OneWay, Converter={StaticResource SegmentTabBackgroundBrushConverter}}"
                                        Foreground="{x:Bind ViewModel.IsTabCriticos, Mode=OneWay, Converter={StaticResource SegmentTabForegroundBrushConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Criticos" />
                                        <TextBlock Text="{x:Bind ViewModel.TransferCriticalTabCountText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource StitchDangerBrush}" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="AlistadoSatelital" Click="TransferTab_Click" Padding="12,6" CornerRadius="6" BorderThickness="0"
                                        Background="{x:Bind ViewModel.IsTabAlistadoSatelital, Mode=OneWay, Converter={StaticResource SegmentTabBackgroundBrushConverter}}"
                                        Foreground="{x:Bind ViewModel.IsTabAlistadoSatelital, Mode=OneWay, Converter={StaticResource SegmentTabForegroundBrushConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Alistado Sat." />
                                        <TextBlock Text="{x:Bind ViewModel.TransferPreparedTabCountText, Mode=OneWay}" Foreground="{StaticResource StitchTextSoftBrush}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <TextBox Width="260" PlaceholderText="Buscar SKU o descripcion..." Style="{StaticResource GuardianTextBoxStyle}" Text="{x:Bind ViewModel.TransferSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Command="{x:Bind ViewModel.ExportRequisitionCommand}" Style="{StaticResource GuardianSecondaryButtonStyle}" Content="Exportar CSV" />
                            <Button Command="{x:Bind ViewModel.ClearOrdersCommand}" Style="{StaticResource GuardianSecondaryButtonStyle}" Content="Limpiar seleccion" />
                            <Button Command="{x:Bind ViewModel.SendSelectedToTransitCommand}" Style="{StaticResource GuardianPrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Style="{StaticResource GuardianIconStyle}" FontSize="15" Glyph="&#xE876;" Foreground="{ThemeResource GuardianOnPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.SendSelectedToTransitButtonText, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer
                        x:Name="TransferTableScrollViewer"
                        Grid.Row="1"
                        Grid.RowSpan="2"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled"
                        ZoomMode="Disabled"
                        SizeChanged="TransferTableViewport_SizeChanged">
                        <Grid
                            x:Name="TransferTableHost"
                            MinHeight="0"
                            HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                    <Grid Grid.Row="0" MinHeight="40" Padding="12,8" ColumnSpacing="6" Background="{StaticResource StitchTableHeaderBrush}" BorderBrush="{StaticResource StitchBorderBrush}" BorderThickness="0,0,0,1" Tag="TransferTable" Loaded="TableHeaderGrid_Loaded">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="180" MinWidth="150" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="0" />
                            <ColumnDefinition Width="0" />
                            <ColumnDefinition Width="0" />
                            <ColumnDefinition Width="0" />
                            <ColumnDefinition Width="220" MinWidth="190" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="0" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" HorizontalAlignment="Left" Padding="2" Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="ARTICULO" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="12" Foreground="{x:Bind ViewModel.TrasladosArticuloFilter.IsActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar articulo" PlaceholderText="Buscar articulo o descripcion" PanelWidth="300" Filter="{x:Bind ViewModel.TrasladosArticuloFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Grid.Column="2" HorizontalAlignment="Left" Padding="2" Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="DESCRIPCION" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="12" Foreground="{x:Bind ViewModel.TrasladosDescripcionFilter.IsActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                            </StackPanel>
