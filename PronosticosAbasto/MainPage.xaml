                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar pallet" PlaceholderText="Buscar pallet" PanelWidth="300" Filter="{x:Bind ViewModel.TrasladosPaletsFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
