                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="12" Foreground="{x:Bind ViewModel.TrasladosArticuloFilter.IsActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar articulo" PlaceholderText="Buscar articulo o descripcion" PanelWidth="300" Filter="{x:Bind ViewModel.TrasladosArticuloFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Grid.Column="2" HorizontalAlignment="Left" Padding="2" Background="Transparent" BorderThickness="0">
