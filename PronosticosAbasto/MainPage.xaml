                                <TextBlock Text="ALISTADO" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="12" Foreground="{x:Bind ViewModel.TrasladosAlistadoFilter.IsActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
