                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="12" Foreground="{x:Bind ViewModel.TrasladosPaletsFilter.IsActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
