                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Copiar fila" Click="CopyRow_Click" />
                                        <MenuFlyoutItem Text="Copiar expediciones" Click="CopyExpeditionsMenuItem_Click" />
                                    </MenuFlyout>
                                </Border.ContextFlyout>
                                <Grid ColumnSpacing="6" Tag="ExpedicionTable" Loaded="TableRowGrid_Loaded">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="148" MinWidth="128" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="190" MinWidth="160" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="94" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="0" />
                                        <ColumnDefinition Width="0" />
                                        <ColumnDefinition Width="0" />
                                        <ColumnDefinition Width="0" />
