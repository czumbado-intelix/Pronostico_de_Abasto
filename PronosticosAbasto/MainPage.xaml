                                <TextBlock Text="ZONA SATELITE" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="12" Foreground="{x:Bind ViewModel.TrasladosZonasFilter.IsActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar zona externa" PlaceholderText="Buscar zona" PanelWidth="300" Filter="{x:Bind ViewModel.TrasladosZonasFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                                </Flyout>
