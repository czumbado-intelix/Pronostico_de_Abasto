                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="12" Foreground="{x:Bind ViewModel.TrasladosEstadoFilter.IsActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar estado" PlaceholderText="Buscar estado" PanelWidth="260" Filter="{x:Bind ViewModel.TrasladosEstadoFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <ListView Grid.Row="2" MinHeight="0" Background="Transparent" BorderThickness="0"
                              ItemContainerStyle="{StaticResource StitchTableListViewItemStyle}"
                              ItemsSource="{x:Bind ViewModel.TransferRows, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedTransferRow, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:TransferRowViewModel">
                                <Grid MinHeight="36" Padding="12,6" ColumnSpacing="6" Background="{StaticResource StitchSurfaceBrush}" ToolTipService.ToolTip="{x:Bind DetailsTooltip, Mode=OneWay}" BorderBrush="{StaticResource StitchBorderBrush}" BorderThickness="0,0,0,1" Tapped="TransferRow_Tapped" Tag="TransferTable" Loaded="TableRowGrid_Loaded">
