                                    <TextBlock Grid.Column="8" Visibility="Collapsed" Text="{x:Bind SuggestedPalletCountText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ToolTip="Cantidad de pallets seleccionados para cubrir la cantidad a traer" Style="{StaticResource GuardianMonoTextStyle}" />
                                    <Button Grid.Column="9" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="4" ToolTipService.ToolTip="{x:Bind AvailablePalletsText}">
