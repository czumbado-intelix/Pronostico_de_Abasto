                                <TextBlock Text="{Binding Article}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource StitchPrimaryBrush}" />
                                <TextBlock Text="{Binding Description}" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Style="{StaticResource GuardianStrongTextStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

