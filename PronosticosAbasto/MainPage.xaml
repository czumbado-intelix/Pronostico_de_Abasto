                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="12" Foreground="{x:Bind ViewModel.TrasladosStockExtFilter.IsActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar stock externo" PlaceholderText="Buscar stock externo" PanelWidth="300" Filter="{x:Bind ViewModel.TrasladosStockExtFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Grid.Column="6" Visibility="Collapsed" HorizontalAlignment="Right" Padding="2" Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="TRANSITO" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="12" Foreground="{x:Bind ViewModel.TrasladosTransitoFilter.IsActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                                    </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar transito" PlaceholderText="Buscar transito" PanelWidth="300" Filter="{x:Bind ViewModel.TrasladosTransitoFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Grid.Column="7" HorizontalAlignment="Right" Padding="2" Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="TRASLADOS" Foreground="{StaticResource StitchPrimaryBrush}" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="12" Foreground="{x:Bind ViewModel.TrasladosTraerFilter.IsActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar cantidad a traer" PlaceholderText="Buscar cantidad" PanelWidth="300" Filter="{x:Bind ViewModel.TrasladosTraerFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                                </Flyout>
