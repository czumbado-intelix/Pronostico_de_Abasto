            Width="460"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Background="{StaticResource StitchSurfaceBrush}"
            BorderBrush="{StaticResource StitchBorderBrush}"
            BorderThickness="1,0,0,0"
            DataContext="{x:Bind ViewModel.SelectedTransferRow, Mode=OneWay}"
