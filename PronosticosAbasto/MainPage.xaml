                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="8" MinWidth="520" MaxWidth="720">
                                                    <TextBlock Text="Palets disponibles por FIFO" Style="{StaticResource GuardianStrongTextStyle}" />
                                                    <TextBlock Text="{x:Bind DetailsTooltip, Mode=OneWay}" Style="{StaticResource GuardianEyebrowTextStyle}" />
