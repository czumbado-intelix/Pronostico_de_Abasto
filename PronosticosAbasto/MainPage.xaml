                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar principal" PlaceholderText="Buscar inventario principal" PanelWidth="300" Filter="{x:Bind ViewModel.TrasladosPrincipalFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
