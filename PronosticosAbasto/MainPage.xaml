                                                                    <TextBlock Grid.Column="2" Text="{x:Bind QuantityText}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource GuardianMonoTextStyle}" />
                                                                    <TextBlock Grid.Column="3" Text="{x:Bind Location}" VerticalAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis" Style="{StaticResource GuardianMonoTextStyle}" />
                                                                    <TextBlock Grid.Column="4" Text="{x:Bind ValidationDateText}" VerticalAlignment="Center" Style="{StaticResource GuardianMonoTextStyle}" />
