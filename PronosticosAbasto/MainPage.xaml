                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource StitchPrimaryBrush}">
                            <PathIcon Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource GuardianOnPrimaryBrush}" Data="M3 6 L15 6 L15 16 L13 16 C12.7 17.7 11.3 19 9.5 19 C7.7 19 6.3 17.7 6 16 L3 16 Z M16 9 L20 9 L23 13 L23 16 L21 16 C20.7 17.7 19.3 19 17.5 19 C15.7 19 14.3 17.7 14 16 L16 16 Z M8 15.5 C8 16.3 8.7 17 9.5 17 C10.3 17 11 16.3 11 15.5 C11 14.7 10.3 14 9.5 14 C8.7 14 8 14.7 8 15.5 Z M16 15.5 C16 16.3 16.7 17 17.5 17 C18.3 17 19 16.3 19 15.5 C19 14.7 18.3 14 17.5 14 C16.7 14 16 14.7 16 15.5 Z M17 10.5 L17 13 L20.5 13 L18.7 10.5 Z" />
                        </Border>
                        <StackPanel Spacing="2">
                            <TextBlock
                                Text="Expediciones"
                                Style="{StaticResource GuardianHeadlineTextStyle}" />
                            <TextBlock
                                Text="Gestión de despacho y cálculo de cobertura desde bodegas satélites"
                                Style="{StaticResource GuardianBodyTextStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button
                            Command="{x:Bind ViewModel.LoadExpedicionesInventoryCommand}"
                            Content="Inventario"
                            ToolTipService.ToolTip="Cargar inventario solo para Expediciones"
                            Style="{StaticResource GuardianSecondaryButtonStyle}" />
                        <Button
                            Command="{x:Bind ViewModel.LoadExpedicionesCommand}"
                            ToolTipService.ToolTip="Cargar archivo de expediciones; si no trae inventario por zona, usa el inventario cargado en Expediciones"
                            Style="{StaticResource GuardianPrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE898;" FontSize="15" Foreground="{ThemeResource GuardianOnPrimaryBrush}" />
                                <TextBlock Text="Cargar expediciones" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid
                    x:Name="ExpedicionMetricCardsGrid"
                    Grid.Row="1"
                    ColumnSpacing="16"
                    RowSpacing="12"
                    HorizontalAlignment="Stretch"
                    SizeChanged="MetricCardsGrid_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="ExpMetricRow0" Height="Auto" />
                        <RowDefinition x:Name="ExpMetricRow1" Height="0" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ExpMetricCol0" Width="*" />
                        <ColumnDefinition x:Name="ExpMetricCol1" Width="*" />
                        <ColumnDefinition x:Name="ExpMetricCol2" Width="*" />
                        <ColumnDefinition x:Name="ExpMetricCol3" Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="ExpMetricEvaluated"
                        MinWidth="180"
                        MinHeight="112"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Style="{StaticResource StitchMetricCardStyle}">
                        <Grid RowSpacing="8" ColumnSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="LÍNEAS EVALUADAS" TextTrimming="CharacterEllipsis" MaxLines="1" Foreground="{StaticResource StitchTextMutedBrush}" Style="{StaticResource GuardianEyebrowTextStyle}" />
                            <Border Grid.Column="1" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform">
                                    <Path Width="24" Height="24" Stretch="Uniform" Fill="{StaticResource StitchTextMutedBrush}" Data="M4 5 H6 V7 H4 Z M8 5 H20 V7 H8 Z M4 11 H6 V13 H4 Z M8 11 H20 V13 H8 Z M4 17 H6 V19 H4 Z M8 17 H20 V19 H8 Z M2 5 H3 V7 H2 Z M2 11 H3 V13 H2 Z M2 17 H3 V19 H2 Z" />
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.ExpEvaluated, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1" FontFamily="{StaticResource GuardianDisplayFontFamily}" FontSize="28" FontWeight="ExtraBold" Foreground="{StaticResource StitchTextPrimaryBrush}" />
                                <TextBlock Text="Expediciones pendientes" TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="12" FontWeight="Medium" Foreground="{StaticResource StitchTextMutedBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border
                        x:Name="ExpMetricCovered"
                        Grid.Column="1"
                        MinWidth="180"
                        MinHeight="112"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Style="{StaticResource StitchMetricCardStyle}">
                        <Grid RowSpacing="8" ColumnSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CUBRE PRINCIPAL" TextTrimming="CharacterEllipsis" MaxLines="1" Foreground="{StaticResource StitchTextMutedBrush}" Style="{StaticResource GuardianEyebrowTextStyle}" />
                            <Border Grid.Column="1" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform">
                                    <Path Width="24" Height="24" Stretch="Uniform" Fill="{StaticResource StitchPrimaryBrush}" Data="M3 20 H21 V10 L12 4 L3 10 Z M5 18 V11.2 L12 6.8 L19 11.2 V18 H16 V13 H8 V18 Z M10 18 V15 H14 V18 Z" />
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.ExpCovered, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1" FontFamily="{StaticResource GuardianDisplayFontFamily}" FontSize="28" FontWeight="ExtraBold" Foreground="{StaticResource StitchTextPrimaryBrush}" />
                                <TextBlock Text="Cubiertas en almacén central" TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="12" FontWeight="Medium" Foreground="{StaticResource StitchTextMutedBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border
                        x:Name="ExpMetricToTransfer"
                        Grid.Column="2"
                        MinWidth="180"
                        MinHeight="112"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Style="{StaticResource StitchPrimaryMetricCardStyle}">
                        <Grid RowSpacing="8" ColumnSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="PARA TRAER" TextTrimming="CharacterEllipsis" MaxLines="1" Foreground="{StaticResource StitchPrimaryBrush}" Style="{StaticResource GuardianEyebrowTextStyle}" />
                            <Border Grid.Column="1" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform">
                                    <Path Width="24" Height="24" Stretch="Uniform" Fill="{StaticResource StitchPrimaryBrush}" Data="M3 17 H4.5 C4.8 15.9 5.8 15 7 15 C8.2 15 9.2 15.9 9.5 17 H13 V7 H15 V17 H17 V5 H19 V17 H21 V19 H19.7 C19.4 20.1 18.4 21 17.2 21 C16 21 15 20.1 14.7 19 H9.5 C9.2 20.1 8.2 21 7 21 C5.8 21 4.8 20.1 4.5 19 H3 Z M5.8 17 H8.2 C8 16.4 7.5 16 7 16 C6.5 16 6 16.4 5.8 17 Z M16 17 H18.4 C18.2 16.4 17.7 16 17.2 16 C16.7 16 16.2 16.4 16 17 Z M5 9 H11 V14 H5 Z M7 11 V12 H9 V11 Z" />
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.ExpToTransfer, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1" FontFamily="{StaticResource GuardianDisplayFontFamily}" FontSize="28" FontWeight="ExtraBold" Foreground="{StaticResource StitchPrimaryBrush}" />
                                    <Border VerticalAlignment="Center" Background="{StaticResource StitchPrimaryBrush}" CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="Líneas requeridas bodegas satélites" TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="10" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Requieren traslado desde externas" TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource StitchTextPrimaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border
                        x:Name="ExpMetricWithoutExternal"
                        Grid.Column="3"
                        MinWidth="180"
                        MinHeight="112"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Style="{StaticResource StitchMetricCardStyle}">
                        <Grid RowSpacing="8" ColumnSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SIN BODEGA EXTERNA" TextTrimming="CharacterEllipsis" MaxLines="1" Foreground="{StaticResource StitchDangerBrush}" Style="{StaticResource GuardianEyebrowTextStyle}" />
                            <Border Grid.Column="1" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform">
                                    <Path Width="24" Height="24" Stretch="Uniform" Fill="{StaticResource StitchDangerBrush}" Data="M12 2 L22 20 H2 Z M11 9 H13 V14 H11 Z M11 16 H13 V18 H11 Z" />
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.ExpWithoutExternal, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1" FontFamily="{StaticResource GuardianDisplayFontFamily}" FontSize="28" FontWeight="ExtraBold" Foreground="{StaticResource StitchDangerBrush}" />
                                <TextBlock Text="Faltante sin stock satélite" TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="12" FontWeight="Medium" Foreground="{StaticResource StitchTextMutedBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource StitchPanelBorderStyle}" Padding="14">
                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="{StaticResource StitchProgressTrackBrush}"
                            CornerRadius="8"
                            Padding="4">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Tag="Todos" Click="ExpedicionTab_Click" Padding="12,6" CornerRadius="6" BorderThickness="0"
                                        Background="{x:Bind ViewModel.IsExpTabTodos, Mode=OneWay, Converter={StaticResource SegmentTabBackgroundBrushConverter}}"
                                        Foreground="{x:Bind ViewModel.IsExpTabTodos, Mode=OneWay, Converter={StaticResource SegmentTabForegroundBrushConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Todos" />
                                        <StackPanel Orientation="Horizontal" Spacing="0">
                                            <TextBlock Text="(" Foreground="{StaticResource StitchTextSoftBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.ExpEvaluated, Mode=OneWay}" Foreground="{StaticResource StitchTextSoftBrush}" />
                                            <TextBlock Text=")" Foreground="{StaticResource StitchTextSoftBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Tag="ParaTraer" Click="ExpedicionTab_Click" Padding="12,6" CornerRadius="6" BorderThickness="0"
                                        Background="{x:Bind ViewModel.IsExpTabParaTraer, Mode=OneWay, Converter={StaticResource SegmentTabBackgroundBrushConverter}}"
                                        Foreground="{x:Bind ViewModel.IsExpTabParaTraer, Mode=OneWay, Converter={StaticResource SegmentTabForegroundBrushConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="Para traer" FontWeight="Bold" />
                                        <Border Background="{StaticResource StitchPrimarySoftBrush}" CornerRadius="3" Padding="6,1">
                                            <TextBlock Text="{x:Bind ViewModel.ExpToTransfer, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource StitchPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                                <Button Tag="Cubiertas" Click="ExpedicionTab_Click" Padding="12,6" CornerRadius="6" BorderThickness="0"
                                        Background="{x:Bind ViewModel.IsExpTabCubiertas, Mode=OneWay, Converter={StaticResource SegmentTabBackgroundBrushConverter}}"
                                        Foreground="{x:Bind ViewModel.IsExpTabCubiertas, Mode=OneWay, Converter={StaticResource SegmentTabForegroundBrushConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Cubiertas" />
                                        <StackPanel Orientation="Horizontal" Spacing="0">
                                            <TextBlock Text="(" Foreground="{StaticResource StitchTextMutedBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.ExpCovered, Mode=OneWay}" Foreground="{StaticResource StitchTextMutedBrush}" />
                                            <TextBlock Text=")" Foreground="{StaticResource StitchTextMutedBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Tag="SinSatelite" Click="ExpedicionTab_Click" Padding="12,6" CornerRadius="6" BorderThickness="0"
                                        Background="{x:Bind ViewModel.IsExpTabSinSatelite, Mode=OneWay, Converter={StaticResource SegmentTabBackgroundBrushConverter}}"
                                        Foreground="{x:Bind ViewModel.IsExpTabSinSatelite, Mode=OneWay, Converter={StaticResource SegmentTabForegroundBrushConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Sin satélite" />
                                        <StackPanel Orientation="Horizontal" Spacing="0">
                                            <TextBlock Text="(" FontWeight="SemiBold" Foreground="{StaticResource StitchDangerBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.ExpWithoutExternal, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource StitchDangerBrush}" />
                                            <TextBlock Text=")" FontWeight="SemiBold" Foreground="{StaticResource StitchDangerBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Tag="AlistadoSatelital" Click="ExpedicionTab_Click" Padding="12,6" CornerRadius="6" BorderThickness="0"
                                        Background="{x:Bind ViewModel.IsExpTabAlistadoSatelital, Mode=OneWay, Converter={StaticResource SegmentTabBackgroundBrushConverter}}"
                                        Foreground="{x:Bind ViewModel.IsExpTabAlistadoSatelital, Mode=OneWay, Converter={StaticResource SegmentTabForegroundBrushConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Alistado Sat." />
                                        <StackPanel Orientation="Horizontal" Spacing="0">
                                            <TextBlock Text="(" Foreground="{StaticResource StitchTextMutedBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.ExpPreparedTotal, Mode=OneWay}" Foreground="{StaticResource StitchTextMutedBrush}" />
                                            <TextBlock Text=")" Foreground="{StaticResource StitchTextMutedBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Column="1" ColumnSpacing="8" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="260" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:ModuleSearchBox
                                x:Name="ExpedicionSearchBox"
                                VerticalAlignment="Center"
                                PlaceholderText="Buscar expedición, artículo, descripción o pallet..."
                                Text="{x:Bind ViewModel.ExpedicionSearchText, Mode=TwoWay}"
                                Summary="{x:Bind ViewModel.ExpedicionSearchSummary, Mode=OneWay}"
                                SubmitCommand="{x:Bind ViewModel.SubmitSearchCommand}" />
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.ExportExpedicionesCommand}" Style="{StaticResource GuardianSecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE896;" FontSize="15" Foreground="{StaticResource StitchTextMutedBrush}" />
                                    <TextBlock Text="Descargar marcados" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Command="{x:Bind ViewModel.SendSelectedExpedicionesToTransitCommand}" Style="{StaticResource GuardianPrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE768;" FontSize="15" Foreground="{ThemeResource GuardianOnPrimaryBrush}" />
                                    <TextBlock Text="Mandar a pedir / Procesar traslados" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <ScrollViewer
                    x:Name="ExpedicionTableScrollViewer"
                    Grid.Row="3"
                    Grid.RowSpan="2"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled"
                    ZoomMode="Disabled"
                    SizeChanged="ExpedicionTableViewport_SizeChanged">
                    <Grid
                        x:Name="ExpedicionTableHost"
                        MinHeight="0"
                        HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    HorizontalAlignment="Stretch"
                    MinHeight="36"
                    Padding="12,8"
                    ColumnSpacing="6"
                    Background="{StaticResource StitchTableHeaderBrush}"
                    BorderBrush="{StaticResource StitchBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Tag="ExpedicionTable"
                    Loaded="TableHeaderGrid_Loaded">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="148" MinWidth="128" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="190" MinWidth="160" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="94" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="220" MinWidth="190" />
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" HorizontalAlignment="Left" Padding="2" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="EXPEDICIÓN" Style="{StaticResource GuardianEyebrowTextStyle}" />
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="12" Foreground="{x:Bind ViewModel.ExpExpedicionFilter.IsActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout>
                                <controls:ExcelTextFilterPanel HeaderText="Filtrar expedicion" PlaceholderText="Buscar expedicion" PanelWidth="260" Filter="{x:Bind ViewModel.ExpExpedicionFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Grid.Column="2" HorizontalAlignment="Left" Padding="2" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="ARTÍCULO" Style="{StaticResource GuardianEyebrowTextStyle}" />
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="12" Foreground="{x:Bind ViewModel.ExpArticuloFilter.IsActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout>
                                <controls:ExcelTextFilterPanel HeaderText="Filtrar articulo" PlaceholderText="Buscar articulo o descripcion" PanelWidth="300" Filter="{x:Bind ViewModel.ExpArticuloFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Grid.Column="3" HorizontalAlignment="Left" Padding="2" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="DESCRIPCIÓN" Style="{StaticResource GuardianEyebrowTextStyle}" />
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="12" Foreground="{x:Bind ViewModel.ExpDescripcionFilter.IsActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout>
                                <controls:ExcelTextFilterPanel HeaderText="Filtrar descripcion" PlaceholderText="Buscar descripcion" PanelWidth="300" Filter="{x:Bind ViewModel.ExpDescripcionFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Grid.Column="4" HorizontalAlignment="Center" Padding="2" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="SOLICITUD" Style="{StaticResource GuardianEyebrowTextStyle}" />
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="12" Foreground="{x:Bind ViewModel.ExpCantidadFilter.IsActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout>
                                <controls:ExcelTextFilterPanel HeaderText="Filtrar solicitud" PlaceholderText="Buscar solicitud" PanelWidth="300" Filter="{x:Bind ViewModel.ExpCantidadFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Grid.Column="5" HorizontalAlignment="Center" Padding="2" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="PRINCIPAL" Style="{StaticResource GuardianEyebrowTextStyle}" />
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="12" Foreground="{x:Bind ViewModel.ExpPrincipalFilter.IsActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout>
                                <controls:ExcelTextFilterPanel HeaderText="Filtrar principal" PlaceholderText="Buscar inventario principal" PanelWidth="300" Filter="{x:Bind ViewModel.ExpPrincipalFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Grid.Column="6" HorizontalAlignment="Center" Padding="2" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="EN EXTERNAS" Style="{StaticResource GuardianEyebrowTextStyle}" />
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="12" Foreground="{x:Bind ViewModel.ExpExternasFilter.IsActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout>
                                <controls:ExcelTextFilterPanel HeaderText="Filtrar en externas" PlaceholderText="Buscar cantidad externa" PanelWidth="300" Filter="{x:Bind ViewModel.ExpExternasFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Grid.Column="7" HorizontalAlignment="Right" Padding="2" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="TRÁNSITO" Style="{StaticResource GuardianEyebrowTextStyle}" />
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="12" Foreground="{x:Bind ViewModel.ExpTransitoFilter.IsActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout>
                                <controls:ExcelTextFilterPanel HeaderText="Filtrar transito" PlaceholderText="Buscar transito" PanelWidth="300" Filter="{x:Bind ViewModel.ExpTransitoFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Grid.Column="8" HorizontalAlignment="Center" Padding="2" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="A TRAER" Foreground="{StaticResource StitchPrimaryBrush}" Style="{StaticResource GuardianEyebrowTextStyle}" />
