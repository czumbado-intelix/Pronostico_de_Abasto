                                        <TextBox
                                            MinWidth="82"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Right"
                                            IsEnabled="{x:Bind CanOrder, Mode=OneWay}"
                                            Text="{x:Bind TransferQuantityInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
