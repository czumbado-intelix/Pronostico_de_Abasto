                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource StitchPanelBorderStyle}" Padding="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{StaticResource StitchProgressTrackBrush}" CornerRadius="8" Padding="4">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Tag="Pendientes" Click="TransitStatusTab_Click" Padding="12,6" CornerRadius="6" BorderThickness="0"
                                        Background="{x:Bind ViewModel.IsTransitTabPendientes, Mode=OneWay, Converter={StaticResource SegmentTabBackgroundBrushConverter}}"
                                        Foreground="{x:Bind ViewModel.IsTransitTabPendientes, Mode=OneWay, Converter={StaticResource SegmentTabForegroundBrushConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="En tránsito" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Spacing="0">
                                            <TextBlock Text="(" Foreground="{StaticResource StitchTextSoftBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.TransitPendingTabCountText, Mode=OneWay}" Foreground="{StaticResource StitchTextSoftBrush}" />
                                            <TextBlock Text=")" Foreground="{StaticResource StitchTextSoftBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Tag="Conciliados" Click="TransitStatusTab_Click" Padding="12,6" CornerRadius="6" BorderThickness="0"
                                        Background="{x:Bind ViewModel.IsTransitTabConciliados, Mode=OneWay, Converter={StaticResource SegmentTabBackgroundBrushConverter}}"
                                        Foreground="{x:Bind ViewModel.IsTransitTabConciliados, Mode=OneWay, Converter={StaticResource SegmentTabForegroundBrushConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="Historial" />
                                        <StackPanel Orientation="Horizontal" Spacing="0">
                                            <TextBlock Text="(" Foreground="{StaticResource StitchTextMutedBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.TransitHistoryTabCountText, Mode=OneWay}" Foreground="{StaticResource StitchTextMutedBrush}" />
                                            <TextBlock Text=")" Foreground="{StaticResource StitchTextMutedBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                            <controls:ModuleSearchBox
                                x:Name="TransitSearchBox"
                                Width="340"
                                VerticalAlignment="Center"
                                PlaceholderText="Buscar artículo, pallet, ubicación o zona..."
                                Text="{x:Bind ViewModel.TransitSearchText, Mode=TwoWay}"
                                Summary="{x:Bind ViewModel.TransitSearchSummary, Mode=OneWay}"
                                SubmitCommand="{x:Bind ViewModel.SubmitSearchCommand}" />
                            <Button Content="Confirmar seleccion" Visibility="{x:Bind ViewModel.TransitActionsVisibility, Mode=OneWay}" Command="{x:Bind ViewModel.ConfirmSelectedTransitCommand}" Style="{StaticResource GuardianSecondaryButtonStyle}" />
                            <Button Content="Confirmar visible" Visibility="{x:Bind ViewModel.TransitActionsVisibility, Mode=OneWay}" Command="{x:Bind ViewModel.ConfirmVisibleTransitCommand}" Style="{StaticResource GuardianPrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Padding="16,8" ColumnSpacing="14" Background="{ThemeResource GuardianSurfaceLowBrush}" Tag="TransitTable" Loaded="TableHeaderGrid_Loaded">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="116" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="ARTICULO" Style="{StaticResource GuardianEyebrowTextStyle}" />
                    <TextBlock Grid.Column="2" Text="DESCRIPCION" Style="{StaticResource GuardianEyebrowTextStyle}" />
                    <TextBlock Grid.Column="3" Text="PALLET" Style="{StaticResource GuardianEyebrowTextStyle}" />
                    <TextBlock Grid.Column="4" Text="CANT." HorizontalAlignment="Center" Style="{StaticResource GuardianEyebrowTextStyle}" />
                    <TextBlock Grid.Column="5" Text="ZONA ORIGEN" Margin="8,0,0,0" Style="{StaticResource GuardianEyebrowTextStyle}" />
                    <TextBlock Grid.Column="6" Text="FECHA" Style="{StaticResource GuardianEyebrowTextStyle}" />
                    <TextBlock Grid.Column="7" Text="ESTADO" Style="{StaticResource GuardianEyebrowTextStyle}" />
                    <TextBlock Grid.Column="8" Text="ACCIONES" Visibility="{x:Bind ViewModel.TransitActionsVisibility, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource GuardianEyebrowTextStyle}" />
                </Grid>

                <ListView
                    Grid.Row="4"
                    MinHeight="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource GuardianListViewItemStyle}"
                    ItemsSource="{x:Bind ViewModel.TransitRows, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:TransitRowViewModel">
                            <Grid Padding="16,8" ColumnSpacing="14" ToolTipService.ToolTip="{x:Bind DetailsTooltip}" BorderBrush="{ThemeResource GuardianBorderSoftBrush}" BorderThickness="0,0,0,1" Tag="TransitTable" Loaded="TableRowGrid_Loaded">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Copiar fila" Click="CopyRow_Click" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="74" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="116" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" Visibility="{x:Bind CanConfirmReceived, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanConfirmReceived}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Article}" VerticalAlignment="Center" IsTextSelectionEnabled="True" Style="{StaticResource GuardianMonoTextStyle}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Description}" VerticalAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis" Style="{StaticResource GuardianBodyTextStyle}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Pallet}" VerticalAlignment="Center" IsTextSelectionEnabled="True" Style="{StaticResource GuardianMonoTextStyle}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind QuantityText}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource GuardianMonoTextStyle}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind OriginLocationText}" Margin="8,0,0,0" VerticalAlignment="Center" IsTextSelectionEnabled="True" MaxLines="1" TextTrimming="CharacterEllipsis" Style="{StaticResource GuardianMonoTextStyle}" />
                                <TextBlock Grid.Column="6" Text="{x:Bind StatusDateText}" VerticalAlignment="Center" Style="{StaticResource GuardianMonoTextStyle}" />
                                <Border Grid.Column="7" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="10,5" CornerRadius="6" Background="{x:Bind StatusBackgroundBrush}" BorderBrush="{x:Bind StatusBorderBrush}" BorderThickness="1">
                                    <TextBlock Text="{x:Bind StatusLabel}" MaxLines="1" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind StatusForegroundBrush}" />
                                </Border>
                                <StackPanel Grid.Column="8" Visibility="{x:Bind CanConfirmReceived, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Orientation="Vertical" HorizontalAlignment="Stretch" Spacing="4">
                                    <Button Content="Pallet recibido" HorizontalAlignment="Stretch" IsEnabled="{x:Bind CanConfirmReceived}" Click="ConfirmTransitPallet_Click" Style="{StaticResource GuardianSecondaryButtonStyle}" />
                                    <Button Content="Articulo completo" HorizontalAlignment="Stretch" IsEnabled="{x:Bind CanConfirmReceived}" Click="ConfirmTransitArticle_Click" Style="{StaticResource GuardianSecondaryButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border Grid.Row="5" Padding="14,10" Background="{StaticResource StitchPrimarySoftBrush}" CornerRadius="8">
                    <TextBlock
                        Text="En tránsito muestra lo que viene en camino. Historial conserva lo recibido sin afectar nuevos cálculos."
                        TextWrapping="Wrap"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource StitchPrimaryBrush}" />
                </Border>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Visibility="{x:Bind ViewModel.WarehouseComparisonViewVisibility, Mode=OneWay}"
            Style="{StaticResource GuardianCardBorderStyle}">
            <Grid MinHeight="0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource StitchPrimaryBrush}">
                            <PathIcon Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource GuardianOnPrimaryBrush}" Data="M4 11 L8 11 L8 20 L4 20 Z M10 4 L14 4 L14 20 L10 20 Z M16 8 L20 8 L20 20 L16 20 Z M3 21 L21 21 L21 23 L3 23 Z" />
                        </Border>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Comparativa e histograma" Style="{StaticResource GuardianStrongTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.WarehouseComparisonSummaryText, Mode=OneWay}" Style="{StaticResource GuardianEyebrowTextStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                        <Button
                            Content="Tabla"
                            Command="{x:Bind ViewModel.SetWarehouseComparisonViewCommand}"
                            CommandParameter="Tabla"
                            Padding="12,4"
                            CornerRadius="4"
                            BorderThickness="0"
                            Background="{x:Bind ViewModel.IsWarehouseComparisonTableSelected, Mode=OneWay, Converter={StaticResource SelectedTabBackgroundBrushConverter}}"
                            Foreground="{x:Bind ViewModel.IsWarehouseComparisonTableSelected, Mode=OneWay, Converter={StaticResource SelectedTabForegroundBrushConverter}}" />
                        <Button
                            Content="Histograma"
                            Command="{x:Bind ViewModel.SetWarehouseComparisonViewCommand}"
                            CommandParameter="Histograma"
                            Padding="12,4"
                            CornerRadius="4"
                            BorderThickness="0"
                            Background="{x:Bind ViewModel.IsWarehouseComparisonHistogramSelected, Mode=OneWay, Converter={StaticResource SelectedTabBackgroundBrushConverter}}"
                            Foreground="{x:Bind ViewModel.IsWarehouseComparisonHistogramSelected, Mode=OneWay, Converter={StaticResource SelectedTabForegroundBrushConverter}}" />
                        <controls:ModuleSearchBox
                            x:Name="WarehouseComparisonSearchBox"
                            Width="300"
                            VerticalAlignment="Center"
                            PlaceholderText="Buscar artículo, descripción o comentario..."
                            Text="{x:Bind ViewModel.WarehouseComparisonSearchText, Mode=TwoWay}"
                            Summary="{x:Bind ViewModel.WarehouseComparisonSearchSummary, Mode=OneWay}"
                            SubmitCommand="{x:Bind ViewModel.SubmitSearchCommand}" />
                        <Button
                            Content="Limpiar filtros"
                            Command="{x:Bind ViewModel.ClearWarehouseComparisonFiltersCommand}"
                            Style="{StaticResource GuardianSecondaryButtonStyle}" />
                        <Button
                            Content="Limpiar comentarios"
                            Command="{x:Bind ViewModel.ClearWarehouseComparisonCommentsCommand}"
                            Style="{StaticResource GuardianSecondaryButtonStyle}" />
                        <Button
                            Content="Exportar comparativa"
                            Command="{x:Bind ViewModel.ExportWarehouseComparisonCommand}"
                            Style="{StaticResource GuardianPrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>

                <TextBlock
                    Grid.Row="1"
                    Text="{x:Bind ViewModel.WarehouseComparisonCaptionText, Mode=OneWay}"
                    Style="{StaticResource GuardianBodyTextStyle}" />

                <Grid
                    Grid.Row="2"
                    MinHeight="0"
                    Visibility="{x:Bind ViewModel.WarehouseComparisonTableVisibility, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        Padding="16,10"
                        Background="{ThemeResource GuardianSurfaceHighBrush}"
                        ColumnSpacing="12"
                        Tag="ComparisonTable"
                        Loaded="TableHeaderGrid_Loaded">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.8*" />
                            <ColumnDefinition Width="0.7*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="1.6*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" HorizontalAlignment="Left" Padding="2" Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="ARTICULO" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="12" Foreground="{x:Bind ViewModel.ComparisonArticuloFilter.IsActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar articulo" PlaceholderText="Buscar articulo o descripcion" PanelWidth="300" Filter="{x:Bind ViewModel.ComparisonArticuloFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button Grid.Column="1" HorizontalAlignment="Left" Padding="2" Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="DESCRIPCION" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="12" Foreground="{x:Bind ViewModel.ComparisonDescripcionFilter.IsActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar descripcion" PlaceholderText="Buscar descripcion" PanelWidth="300" Filter="{x:Bind ViewModel.ComparisonDescripcionFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button Grid.Column="2" HorizontalAlignment="Right" Padding="2" Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="INV OLO" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="12" Foreground="{x:Bind ViewModel.ComparisonOloFilter.IsActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar Inv OLO" PlaceholderText="Buscar Inv OLO" PanelWidth="300" Filter="{x:Bind ViewModel.ComparisonOloFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button Grid.Column="3" HorizontalAlignment="Right" Padding="2" Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="INV SERVICA" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="12" Foreground="{x:Bind ViewModel.ComparisonServicaFilter.IsActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar Inv Servica" PlaceholderText="Buscar Inv Servica" PanelWidth="300" Filter="{x:Bind ViewModel.ComparisonServicaFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button Grid.Column="4" HorizontalAlignment="Right" Padding="2" Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="SEMANAS OLO" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="12" Foreground="{x:Bind ViewModel.ComparisonCoverageFilter.IsActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar semanas OLO" PlaceholderText="Buscar semanas" PanelWidth="300" Filter="{x:Bind ViewModel.ComparisonCoverageFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button Grid.Column="5" HorizontalAlignment="Left" Padding="2" Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="COMENTARIOS" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="12" Foreground="{x:Bind ViewModel.ComparisonComentariosFilter.IsActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar comentarios" PlaceholderText="Buscar comentario" PanelWidth="300" Filter="{x:Bind ViewModel.ComparisonComentariosFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <ListView
                        Grid.Row="1"
                        MinHeight="0"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource GuardianListViewItemStyle}"
                        ItemsSource="{x:Bind ViewModel.WarehouseComparisonRows, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:WarehouseComparisonRowViewModel">
                                <Grid Padding="16,8" ColumnSpacing="12" BorderBrush="{ThemeResource GuardianBorderSoftBrush}" BorderThickness="0,0,0,1" Tag="ComparisonTable" Loaded="TableRowGrid_Loaded">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Copiar fila" Click="CopyRow_Click" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1.8*" />
                                        <ColumnDefinition Width="0.7*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="1.6*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Article}" VerticalAlignment="Center" IsTextSelectionEnabled="True" Style="{StaticResource GuardianMonoTextStyle}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Description}" VerticalAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" ToolTipService.ToolTip="{x:Bind Description}" Style="{StaticResource GuardianBodyTextStyle}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind OloQuantityText}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource GuardianMonoTextStyle}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind ServicaQuantityText}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource GuardianMonoTextStyle}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind CoverageText}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource GuardianMonoTextStyle}" />
                                    <TextBox Grid.Column="5" Text="{x:Bind CommentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Comentario" Style="{StaticResource GuardianTextBoxStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid
                    Grid.Row="2"
                    MinHeight="0"
                    RowSpacing="12"
                    Visibility="{x:Bind ViewModel.WarehouseComparisonHistogramVisibility, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Distribucion de cobertura OLO" Style="{StaticResource GuardianStrongTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.WarehouseComparisonCoverageSummaryText, Mode=OneWay}" Style="{StaticResource GuardianEyebrowTextStyle}" />
                    </StackPanel>

                    <lvc:CartesianChart
                        Grid.Row="1"
                        MinHeight="360"
                        Series="{x:Bind ViewModel.WarehouseComparisonCoverageSeries, Mode=OneWay}"
                        XAxes="{x:Bind ViewModel.WarehouseComparisonCoverageXAxes, Mode=OneWay}"
                        YAxes="{x:Bind ViewModel.WarehouseComparisonCoverageYAxes, Mode=OneWay}" />
                </Grid>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Visibility="{x:Bind ViewModel.SimulacionViewVisibility, Mode=OneWay}"
            Style="{StaticResource GuardianCardBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                            <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource StitchPrimaryBrush}">
                                <PathIcon Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource GuardianOnPrimaryBrush}" Data="M9 2 L15 2 L15 4 L14 4 L14 9.2 L20.5 20.5 C21.1 21.5 20.4 23 19.2 23 L4.8 23 C3.6 23 2.9 21.5 3.5 20.5 L10 9.2 L10 4 L9 4 Z M12 10.1 L5.8 21 L18.2 21 Z M8 17 L16 17 L18 20 L6 20 Z" />
                            </Border>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Simulacion Logistica" Style="{StaticResource GuardianTitleTextStyle}" />
                                <TextBlock Text="Modelado predictivo y analisis de escenarios" Style="{StaticResource GuardianBodyTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                            <Button Content="Restablecer" Command="{x:Bind ViewModel.RestablecerSimulacionCommand}" Style="{StaticResource GuardianSecondaryButtonStyle}" />
                            <Button Content="Ejecutar simulacion" Command="{x:Bind ViewModel.EjecutarSimulacionCommand}" Style="{StaticResource GuardianPrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border
                        Background="{ThemeResource GuardianBgElevatedBrush}"
                        BorderBrush="{ThemeResource GuardianBorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="CONSTRUCTOR DE ESCENARIOS" Style="{StaticResource GuardianEyebrowTextStyle}" />
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <Grid>
                                        <TextBlock Text="Horizonte de pronostico (meses)" Style="{StaticResource GuardianStrongTextStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.HorizonLabel, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource GuardianMonoTextStyle}" />
                                    </Grid>
                                    <Slider Minimum="1" Maximum="6" StepFrequency="1" Value="{x:Bind ViewModel.HorizonMonths, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <Grid>
                                        <TextBlock Text="% buffer de stock de seguridad" Style="{StaticResource GuardianStrongTextStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.SafetyBufferLabel, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource GuardianMonoTextStyle}" />
                                    </Grid>
                                    <Slider Minimum="0" Maximum="50" StepFrequency="5" Value="{x:Bind ViewModel.SafetyBufferPercent, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Background="{ThemeResource GuardianBgElevatedBrush}"
                            BorderBrush="{ThemeResource GuardianBorderSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Comparativa dinamica" Style="{StaticResource GuardianStrongTextStyle}" />
                                <TextBlock Text="Demanda pronosticada por empresa (con buffer)" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                <lvc:CartesianChart
                                    Height="300"
                                    Series="{x:Bind ViewModel.SimDemandSeries, Mode=OneWay}"
                                    XAxes="{x:Bind ViewModel.SimDemandXAxes, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Background="{ThemeResource GuardianBgElevatedBrush}"
                            BorderBrush="{ThemeResource GuardianBorderSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Carga de trabajo proyectada" Style="{StaticResource GuardianStrongTextStyle}" />
                                <TextBlock Text="Volumen de traslado por periodo" Style="{StaticResource GuardianEyebrowTextStyle}" />
                                <lvc:CartesianChart
                                    Height="300"
                                    Series="{x:Bind ViewModel.SimLoadSeries, Mode=OneWay}"
                                    XAxes="{x:Bind ViewModel.SimLoadXAxes, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock
                        Text="{x:Bind ViewModel.SimulacionStatusText, Mode=OneWay}"
                        Style="{StaticResource GuardianBodyTextStyle}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

