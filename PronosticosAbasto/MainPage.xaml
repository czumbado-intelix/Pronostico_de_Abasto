                                    <TextBlock Grid.Column="3" Text="{x:Bind CoverageText}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ToolTip="Semanas del forecast que cubre el inventario principal" Style="{StaticResource GuardianMonoTextStyle}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind PrincipalInventoryText}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ToolTip="Inventario en la bodega principal" Style="{StaticResource GuardianMonoTextStyle}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind SatelliteAvailableText}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource GuardianMonoTextStyle}" />
                                    <TextBlock Grid.Column="6" Visibility="Collapsed" Text="{x:Bind PendingTransitText}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ToolTip="Pedidos anteriores que siguen pendientes" Style="{StaticResource GuardianMonoTextStyle}" />
