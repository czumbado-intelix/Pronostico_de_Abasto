<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PronosticosAbasto.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:PronosticosAbasto.ViewModels"
    xmlns:controls="using:PronosticosAbasto.Controls"
    xmlns:converters="using:PronosticosAbasto.Converters"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    Background="{ThemeResource GuardianWindowBackgroundBrush}"
    PointerExited="Page_PointerExited"
    PointerMoved="Page_PointerMoved"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToAccentBrushConverter x:Key="FilterBrushConverter" />
        <converters:BoolToCardBrushConverter x:Key="TabBrushConverter" />
        <converters:BoolToSelectedTabBackgroundBrushConverter x:Key="SelectedTabBackgroundBrushConverter" />
        <converters:BoolToSelectedTabForegroundBrushConverter x:Key="SelectedTabForegroundBrushConverter" />
        <converters:BoolToSelectedTabBorderBrushConverter x:Key="SelectedTabBorderBrushConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid x:Name="ShellRoot">
    <NavigationView
        x:Name="NavView"
        Margin="72,0,0,0"
        IsBackButtonVisible="Collapsed"
        IsPaneVisible="False"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="False"
        CompactPaneLength="72"
        IsPaneOpen="False"
        PaneDisplayMode="LeftCompact"
        OpenPaneLength="256"
        SelectionChanged="NavView_SelectionChanged">
        <NavigationView.Resources>
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#000000" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#000000" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#000000" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemIconForeground" Color="#6B7280" />
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundPointerOver" Color="#000000" />
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundPressed" Color="#000000" />
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelected" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelectedPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelectedPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#00A88F" Opacity="0.10" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#00A88F" Opacity="0.18" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#00A88F" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#00A88F" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#00977F" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#00A88F" />
        </NavigationView.Resources>
        <NavigationView.PaneHeader>
            <Grid Height="76" Padding="16,0,16,0" BorderBrush="{StaticResource StitchBorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource StitchSurfaceBrush}" BorderBrush="{StaticResource StitchBorderBrush}" BorderThickness="1">
                        <Image Source="ms-appx:///Assets/BrandLogo.png" Stretch="Uniform" />
                    </Border>
                    <StackPanel Spacing="0" VerticalAlignment="Center" Width="150">
                        <TextBlock Text="Pronostico de Abasto" FontFamily="{StaticResource GuardianFontFamily}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource StitchTextPrimaryBrush}" />
                        <TextBlock Text="LOGISTICA &amp; SUPPLY" FontFamily="{StaticResource GuardianFontFamily}" FontSize="10" FontWeight="Medium" CharacterSpacing="40" Foreground="{StaticResource StitchTextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Traslados" Tag="Traslados" IsSelected="True" MinHeight="52" Margin="8,4" FontSize="16" FontWeight="SemiBold">
                <NavigationViewItem.Icon>
                    <PathIcon Width="24" Height="24" Data="M7 7 L17 7 L14 4 L15.4 2.6 L20.8 8 L15.4 13.4 L14 12 L17 9 L7 9 Z M17 17 L7 17 L10 20 L8.6 21.4 L3.2 16 L8.6 10.6 L10 12 L7 15 L17 15 Z" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Expediciones" Tag="Expediciones" MinHeight="52" Margin="8,4" FontSize="16" FontWeight="SemiBold">
                <NavigationViewItem.Icon>
                    <PathIcon Width="24" Height="24" Data="M3 6 L15 6 L15 16 L13 16 C12.7 17.7 11.3 19 9.5 19 C7.7 19 6.3 17.7 6 16 L3 16 Z M16 9 L20 9 L23 13 L23 16 L21 16 C20.7 17.7 19.3 19 17.5 19 C15.7 19 14.3 17.7 14 16 L16 16 Z M8 15.5 C8 16.3 8.7 17 9.5 17 C10.3 17 11 16.3 11 15.5 C11 14.7 10.3 14 9.5 14 C8.7 14 8 14.7 8 15.5 Z M16 15.5 C16 16.3 16.7 17 17.5 17 C18.3 17 19 16.3 19 15.5 C19 14.7 18.3 14 17.5 14 C16.7 14 16 14.7 16 15.5 Z M17 10.5 L17 13 L20.5 13 L18.7 10.5 Z" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Transito" Tag="Transito" MinHeight="52" Margin="8,4" FontSize="16" FontWeight="SemiBold">
                <NavigationViewItem.Icon>
                    <PathIcon Width="24" Height="24" Data="M12 2 C6.5 2 2 6.5 2 12 C2 17.5 6.5 22 12 22 C17.5 22 22 17.5 22 12 C22 6.5 17.5 2 12 2 Z M12 4 C16.4 4 20 7.6 20 12 C20 16.4 16.4 20 12 20 C7.6 20 4 16.4 4 12 C4 7.6 7.6 4 12 4 Z M11 7 L13 7 L13 11.4 L16.8 13.7 L15.8 15.4 L11 12.5 Z" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Comparativa e histograma" Tag="Comparativa" MinHeight="52" Margin="8,4" FontSize="16" FontWeight="SemiBold">
                <NavigationViewItem.Icon>
                    <PathIcon Width="24" Height="24" Data="M4 11 L8 11 L8 20 L4 20 Z M10 4 L14 4 L14 20 L10 20 Z M16 8 L20 8 L20 20 L16 20 Z M3 21 L21 21 L21 23 L3 23 Z" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Simulacion" Tag="Simulacion" MinHeight="52" Margin="8,4" FontSize="16" FontWeight="SemiBold">
                <NavigationViewItem.Icon>
                    <PathIcon Width="24" Height="24" Data="M9 2 L15 2 L15 4 L14 4 L14 9.2 L20.5 20.5 C21.1 21.5 20.4 23 19.2 23 L4.8 23 C3.6 23 2.9 21.5 3.5 20.5 L10 9.2 L10 4 L9 4 Z M12 10.1 L5.8 21 L18.2 21 Z M8 17 L16 17 L18 20 L6 20 Z" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.PaneFooter>
            <StackPanel Padding="12,4,12,12" Spacing="2">
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8,8"
                    Command="{x:Bind ViewModel.ManageSettingsCommand}"
                    ToolTipService.ToolTip="Ajustes: umbrales, zonas externas, alistado satelital y tamanos de tarima">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="18" />
                        <TextBlock Text="Ajustes" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8,8"
                    Click="Help_Click"
                    ToolTipService.ToolTip="Ayuda sobre el flujo de abasto">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE897;" FontSize="18" />
                        <TextBlock Text="Ayuda" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Height="1" Margin="4,8" Background="{StaticResource StitchBorderBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="10" Padding="8,4" ToolTipService.ToolTip="{x:Bind ViewModel.UserDisplayName, Mode=OneWay}">
                    <Border Width="32" Height="32" CornerRadius="4" Background="{StaticResource StitchBlackBrush}">
                        <TextBlock Text="{x:Bind ViewModel.UserInitials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="0" MaxWidth="138">
                        <TextBlock Text="{x:Bind ViewModel.UserDisplayName}" MaxLines="1" TextTrimming="CharacterEllipsis" Style="{StaticResource GuardianStrongTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.UserSubtitle}" MaxLines="1" TextTrimming="CharacterEllipsis" Style="{StaticResource GuardianEyebrowTextStyle}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </NavigationView.PaneFooter>

        <NavigationView.Header>
            <Border Height="64" Background="{StaticResource StitchSurfaceBrush}" BorderBrush="{StaticResource StitchBorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="12" Padding="8,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                        <Border Width="38" Height="38" CornerRadius="8" Background="{StaticResource StitchPrimaryBrush}">
                            <Grid>
                                <PathIcon Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource GuardianOnPrimaryBrush}" Visibility="{x:Bind ViewModel.ShowTransferView, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Data="M7 7 L17 7 L14 4 L15.4 2.6 L20.8 8 L15.4 13.4 L14 12 L17 9 L7 9 Z M17 17 L7 17 L10 20 L8.6 21.4 L3.2 16 L8.6 10.6 L10 12 L7 15 L17 15 Z" />
                                <PathIcon Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource GuardianOnPrimaryBrush}" Visibility="{x:Bind ViewModel.ShowExpedicionesView, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Data="M3 6 L15 6 L15 16 L13 16 C12.7 17.7 11.3 19 9.5 19 C7.7 19 6.3 17.7 6 16 L3 16 Z M16 9 L20 9 L23 13 L23 16 L21 16 C20.7 17.7 19.3 19 17.5 19 C15.7 19 14.3 17.7 14 16 L16 16 Z M8 15.5 C8 16.3 8.7 17 9.5 17 C10.3 17 11 16.3 11 15.5 C11 14.7 10.3 14 9.5 14 C8.7 14 8 14.7 8 15.5 Z M16 15.5 C16 16.3 16.7 17 17.5 17 C18.3 17 19 16.3 19 15.5 C19 14.7 18.3 14 17.5 14 C16.7 14 16 14.7 16 15.5 Z M17 10.5 L17 13 L20.5 13 L18.7 10.5 Z" />
                                <PathIcon Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource GuardianOnPrimaryBrush}" Visibility="{x:Bind ViewModel.ShowTransitView, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Data="M12 2 C6.5 2 2 6.5 2 12 C2 17.5 6.5 22 12 22 C17.5 22 22 17.5 22 12 C22 6.5 17.5 2 12 2 Z M12 4 C16.4 4 20 7.6 20 12 C20 16.4 16.4 20 12 20 C7.6 20 4 16.4 4 12 C4 7.6 7.6 4 12 4 Z M11 7 L13 7 L13 11.4 L16.8 13.7 L15.8 15.4 L11 12.5 Z" />
                                <PathIcon Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource GuardianOnPrimaryBrush}" Visibility="{x:Bind ViewModel.ShowWarehouseComparisonView, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Data="M4 11 L8 11 L8 20 L4 20 Z M10 4 L14 4 L14 20 L10 20 Z M16 8 L20 8 L20 20 L16 20 Z M3 21 L21 21 L21 23 L3 23 Z" />
                                <PathIcon Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource GuardianOnPrimaryBrush}" Visibility="{x:Bind ViewModel.ShowSimulacionView, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Data="M9 2 L15 2 L15 4 L14 4 L14 9.2 L20.5 20.5 C21.1 21.5 20.4 23 19.2 23 L4.8 23 C3.6 23 2.9 21.5 3.5 20.5 L10 9.2 L10 4 L9 4 Z M12 10.1 L5.8 21 L18.2 21 Z M8 17 L16 17 L18 20 L6 20 Z" />
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <TextBlock
                                Text="{x:Bind ViewModel.SectionTitle, Mode=OneWay}"
                                Style="{StaticResource GuardianTitleTextStyle}" />
                            <TextBlock
                                Text="Pronostico de Abasto"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{StaticResource StitchTextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="12">
                        <Border Background="{StaticResource StitchSurfaceBrush}" BorderBrush="{StaticResource StitchBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="2">
                            <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                                <Button Tag="EPA" Click="SelectCompany_Click" Background="Transparent" BorderThickness="0" Padding="12,4" CornerRadius="4">
                                    <TextBlock Text="EPA" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{x:Bind ViewModel.IsCompanyEpa, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                                </Button>
                                <Button Tag="Cofersa" Click="SelectCompany_Click" Background="Transparent" BorderThickness="0" Padding="12,4" CornerRadius="4">
                                    <TextBlock Text="Cofersa" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{x:Bind ViewModel.IsCompanyCofersa, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Width="1" Height="16" Background="{StaticResource StitchBorderBrush}" />
                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            Click="ThemeToggle_Click"
                            ToolTipService.ToolTip="Cambiar tema claro / oscuro"
                            Style="{StaticResource GuardianSecondaryButtonStyle}">
                            <FontIcon Glyph="&#xE793;" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </NavigationView.Header>

        <Grid
            x:Name="RootGrid"
            Padding="24,24,24,24"
            RowSpacing="12">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="16" />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.ChildrenTransitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            Visibility="{x:Bind ViewModel.LoadPanelVisibility, Mode=OneWay}"
            Style="{StaticResource StitchPanelBorderStyle}">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                <Grid
                    ColumnSpacing="12"
                    HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        MinWidth="132"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.LoadInventoryCommand}"
                        Content="Cargar Inventario"
                        ToolTipService.ToolTip="Cargar inventario solo para el modulo activo"
                        Style="{StaticResource GuardianSecondaryButtonStyle}" />

                    <Button
                        Grid.Column="1"
                        MinWidth="124"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.LoadForecastCommand}"
                        Content="Cargar Forecast"
                        ToolTipService.ToolTip="Cargar forecast solo para el modulo activo"
                        Style="{StaticResource GuardianSecondaryButtonStyle}" />

                    <ComboBox
                        Grid.Column="2"
                        Width="128"
                        Header="{x:Bind ViewModel.PeriodSelectorHeader, Mode=OneWay}"
                        DisplayMemberPath="Label"
                        ItemsSource="{x:Bind ViewModel.AvailableWeeks, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedWeek, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.AnalysisPeriodControlsVisibility, Mode=OneWay}"
                        Style="{StaticResource GuardianComboBoxStyle}" />

                    <ComboBox
                        Grid.Column="3"
                        Width="128"
                        Header="Horizonte"
                        DisplayMemberPath="Label"
                        ItemsSource="{x:Bind ViewModel.HorizonOptions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedHorizon, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.HorizonControlsVisibility, Mode=OneWay}"
                        ToolTipService.ToolTip="Desde la semana elegida: 4 o 5 semanas, o 1/2/3 meses corridos"
                        Style="{StaticResource GuardianComboBoxStyle}" />

                    <Button
                        Grid.Column="4"
                        MinWidth="108"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.ExportCommand}"
                        Content="Exportar"
                        Visibility="{x:Bind ViewModel.NonComparisonLoadControlsVisibility, Mode=OneWay}"
                        ToolTipService.ToolTip="Exportar el analisis a Excel"
                        Style="{StaticResource GuardianSecondaryButtonStyle}" />

                    <Button
                        Grid.Column="5"
                        MinWidth="126"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.LoadPreparedArticlesCommand}"
                        Content="Alistado: Sat."
                        Visibility="{x:Bind ViewModel.NonComparisonLoadControlsVisibility, Mode=OneWay}"
                        ToolTipService.ToolTip="Importar articulos que se alistan en bodegas satelitales"
                        Style="{StaticResource GuardianSecondaryButtonStyle}" />

                    <Button
                        Grid.Column="6"
                        MinWidth="122"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.LoadTarimaSizesCommand}"
                        Content="Tam. tarimas"
                        Visibility="{x:Bind ViewModel.NonComparisonLoadControlsVisibility, Mode=OneWay}"
                        ToolTipService.ToolTip="Importar tamanos de tarima por articulo"
                        Style="{StaticResource GuardianSecondaryButtonStyle}" />

                    <ProgressRing
                        Grid.Column="7"
                        Width="28"
                        Height="28"
                        VerticalAlignment="Bottom"
                        Foreground="{ThemeResource GuardianPrimaryBrush}"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </Grid>
                </ScrollViewer>

                <Border
                    Grid.Row="1"
                    HorizontalAlignment="Left"
                    Background="{StaticResource StitchPrimarySoftBrush}"
                    BorderBrush="{StaticResource StitchPrimaryBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource StitchPrimaryBrush}" />
                        <TextBlock Text="Listo:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource StitchTextPrimaryBrush}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.LoadSummaryText, Mode=OneWay}"
                            FontSize="12"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{StaticResource StitchTextPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid
            x:Name="MainContentGrid"
            Grid.Row="1"
            MinHeight="0"
            ColumnSpacing="18"
            RowSpacing="16"
            Visibility="{x:Bind ViewModel.TableViewVisibility, Mode=OneWay}"
            SizeChanged="MainContentGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MainCol0" Width="1.9*" />
                <ColumnDefinition x:Name="MainCol1" Width="1.1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="MainRow0" Height="*" />
                <RowDefinition x:Name="MainRow1" Height="0" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Grid.Column="0"
                Style="{StaticResource GuardianCardBorderStyle}">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Text="COBERTURA PRINCIPAL"
                        Style="{StaticResource GuardianEyebrowTextStyle}" />

                    <Grid
                        Grid.Row="1"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Background="{ThemeResource GuardianInfoLowBrush}"
                            BorderBrush="{ThemeResource GuardianBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="ARTICULOS"
                                    Style="{StaticResource GuardianEyebrowTextStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.TotalArticles, Mode=OneWay}"
                                    FontSize="24"
                                    Style="{StaticResource GuardianStrongTextStyle}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Background="{ThemeResource GuardianDangerLowBrush}"
                            BorderBrush="{ThemeResource GuardianDangerBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,10">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    Text="ROJO"
                                    Style="{StaticResource GuardianEyebrowTextStyle}"
                                    Foreground="{ThemeResource GuardianDangerBrush}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.CriticalCount, Mode=OneWay}"
                                    FontSize="24"
                                    Style="{StaticResource GuardianStrongTextStyle}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="2"
                            Background="{ThemeResource GuardianWarningLowBrush}"
                            BorderBrush="{ThemeResource GuardianWarningBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,10">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    Text="AMARILLO"
                                    Style="{StaticResource GuardianEyebrowTextStyle}"
                                    Foreground="{ThemeResource GuardianWarningBrush}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.WarningCount, Mode=OneWay}"
                                    FontSize="24"
                                    Style="{StaticResource GuardianStrongTextStyle}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="3"
                            Background="{ThemeResource GuardianSuccessLowBrush}"
                            BorderBrush="{ThemeResource GuardianSuccessBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,10">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    Text="VERDE"
                                    Style="{StaticResource GuardianEyebrowTextStyle}"
                                    Foreground="{ThemeResource GuardianSuccessBrush}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.HealthyCount, Mode=OneWay}"
                                    FontSize="24"
                                    Style="{StaticResource GuardianStrongTextStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock
                        Grid.Row="2"
                        Text="Articulos evaluados"
                        VerticalAlignment="Center"
                        Style="{StaticResource GuardianStrongTextStyle}" />

                    <Grid Grid.Row="3">
                        <Button
                            HorizontalAlignment="Right"
                            MinWidth="120"
                            Command="{x:Bind ViewModel.ClearFiltersCommand}"
                            Content="Limpiar filtros"
                            ToolTipService.ToolTip="Quitar todos los filtros de columna"
                            Style="{StaticResource GuardianSecondaryButtonStyle}" />
                    </Grid>

                    <Grid
                        Grid.Row="4"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="0.85*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="0.9*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Padding="4,2"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Articulo / descripcion" VerticalAlignment="Center" Style="{StaticResource GuardianStrongTextStyle}" />
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="11" Foreground="{x:Bind ViewModel.ArticleFilterActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar articulo" PlaceholderText="Buscar articulo o descripcion" PanelWidth="300" Filter="{x:Bind ViewModel.TableArticuloFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button
                            Grid.Column="1"
                            Padding="4,2"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.ForecastColumnHeader, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource GuardianStrongTextStyle}" />
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="11" Foreground="{x:Bind ViewModel.ForecastFilterActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar forecast" PlaceholderText="Buscar forecast" PanelWidth="300" Filter="{x:Bind ViewModel.TableForecastFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button
                            Grid.Column="2"
                            Padding="4,2"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Principal" VerticalAlignment="Center" Style="{StaticResource GuardianStrongTextStyle}" />
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="11" Foreground="{x:Bind ViewModel.PrincipalFilterActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar principal" PlaceholderText="Buscar principal" PanelWidth="300" Filter="{x:Bind ViewModel.TablePrincipalFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button
                            Grid.Column="3"
                            Padding="4,2"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Dif. Pr." VerticalAlignment="Center" Style="{StaticResource GuardianStrongTextStyle}" />
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="11" Foreground="{x:Bind ViewModel.DiffFilterActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar diferencia" PlaceholderText="Buscar diferencia" PanelWidth="300" Filter="{x:Bind ViewModel.TableDifferenceFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button
                            Grid.Column="4"
                            Padding="4,2"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Estado Pr." VerticalAlignment="Center" Style="{StaticResource GuardianStrongTextStyle}" />
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="11" Foreground="{x:Bind ViewModel.StatusFilterActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar estado" PlaceholderText="Buscar estado" PanelWidth="260" Filter="{x:Bind ViewModel.TableStatusFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button
                            Grid.Column="5"
                            Padding="4,2"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Sat." VerticalAlignment="Center" Style="{StaticResource GuardianStrongTextStyle}" />
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="11" Foreground="{x:Bind ViewModel.SatFilterActive, Mode=OneWay, Converter={StaticResource FilterBrushConverter}}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <controls:ExcelTextFilterPanel HeaderText="Filtrar satelite" PlaceholderText="Buscar satelite" PanelWidth="300" Filter="{x:Bind ViewModel.TableSatelliteFilter}" SortAscendingCommand="{x:Bind ViewModel.SortColumnAscendingCommand}" SortDescendingCommand="{x:Bind ViewModel.SortColumnDescendingCommand}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <ListView
                        Grid.Row="5"
                        MinHeight="0"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource GuardianListViewItemStyle}"
                        ItemsSource="{x:Bind ViewModel.FilteredResults, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedArticle, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ArticleResultRowViewModel">
                                <Border
                                    Background="{ThemeResource GuardianBgElevatedBrush}"
                                    BorderBrush="{ThemeResource GuardianBorderSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10,8">
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Copiar fila" Click="CopyRow_Click" />
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="0.85*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="0.9*" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Background="{x:Bind StatusAccentBrush}"
                                            CornerRadius="20" />

                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Spacing="3">
                                            <TextBlock
                                                Text="{x:Bind Article}"
                                                MaxLines="1"
                                                TextTrimming="CharacterEllipsis"
                                                Style="{StaticResource GuardianStrongTextStyle}" />
                                            <TextBlock
                                                Text="{x:Bind Description}"
                                                MaxLines="1"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="{ThemeResource GuardianTextSecondaryBrush}" />
                                            <TextBlock
                                                Text="{x:Bind ZoneSummaryText}"
                                                Style="{StaticResource GuardianEyebrowTextStyle}"
                                                Foreground="{ThemeResource GuardianTextSecondaryBrush}" />
                                            <TextBlock
                                                Text="{x:Bind TransferInstructionText}"
                                                Visibility="{x:Bind TransferInstructionVisibility}"
                                                Foreground="{x:Bind TransferAccentBrush}"
                                                TextWrapping="Wrap"
                                                MaxLines="2"
                                                Style="{StaticResource GuardianEyebrowTextStyle}" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind ForecastText}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource GuardianMonoTextStyle}" />

                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{x:Bind PrincipalInventoryText}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource GuardianMonoTextStyle}" />

                                        <TextBlock
                                            Grid.Column="4"
                                            Text="{x:Bind DifferenceText}"
                                            Foreground="{x:Bind GeneralAccentBrush}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource GuardianMonoTextStyle}" />

                                        <Border
                                            Grid.Column="5"
                                            Background="{x:Bind GeneralPillBrush}"
                                            BorderBrush="{x:Bind GeneralBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="18"
                                            Padding="10,4"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind StatusLabel}"
                                                Foreground="{x:Bind GeneralAccentBrush}"
                                                Style="{StaticResource GuardianEyebrowTextStyle}" />
                                        </Border>

                                        <TextBlock
                                            Grid.Column="6"
                                            Text="{x:Bind SatelliteInventoryText}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource GuardianMonoTextStyle}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid
                x:Name="DetailColumnPanel"
                Grid.Row="0"
                Grid.Column="1"
                MinHeight="0"
                RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    Background="{ThemeResource GuardianBgElevatedBrush}"
                    BorderBrush="{ThemeResource GuardianBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Foreground="{ThemeResource GuardianTextPrimaryBrush}"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.IsMessageOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.MessageText, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
                    Title="{x:Bind ViewModel.MessageTitle, Mode=OneWay}" />

                <Border
                    Grid.Row="1"
                    Style="{StaticResource GuardianCardBorderStyle}">
                    <Grid
                        MinHeight="0"
                        RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Text="STOCK Y TRASLADO"
                            Style="{StaticResource GuardianEyebrowTextStyle}" />
                        <TextBlock
                            Grid.Row="1"
                            Text="{x:Bind ViewModel.DetailTitle, Mode=OneWay}"
                            Style="{StaticResource GuardianStrongTextStyle}" />

                        <Grid
                            Grid.Row="2"
                            MinHeight="0"
                            RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="10" RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Background="{ThemeResource GuardianPrimaryLowBrush}"
                                    BorderBrush="{ThemeResource GuardianBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="{x:Bind ViewModel.ForecastHeaderCaption, Mode=OneWay}"
                                            Style="{StaticResource GuardianEyebrowTextStyle}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.DetailForecastText, Mode=OneWay}"
                                            Style="{StaticResource GuardianMonoTextStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Background="{ThemeResource GuardianInfoLowBrush}"
                                    BorderBrush="{ThemeResource GuardianBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="PRINCIPAL"
                                            Style="{StaticResource GuardianEyebrowTextStyle}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.DetailPrincipalInventoryText, Mode=OneWay}"
                                            Style="{StaticResource GuardianMonoTextStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Row="1"
                                    Background="{ThemeResource GuardianSuccessLowBrush}"
                                    BorderBrush="{ThemeResource GuardianSuccessBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="SATELITAL"
                                            Style="{StaticResource GuardianEyebrowTextStyle}"
                                            Foreground="{ThemeResource GuardianSuccessBrush}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.DetailSatelliteInventoryText, Mode=OneWay}"
                                            Style="{StaticResource GuardianMonoTextStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Background="{ThemeResource GuardianPrimaryLowBrush}"
                                    BorderBrush="{ThemeResource GuardianBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="TOTAL"
                                            Style="{StaticResource GuardianEyebrowTextStyle}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.DetailTotalInventoryText, Mode=OneWay}"
                                            Style="{StaticResource GuardianMonoTextStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Row="2"
                                    Background="{ThemeResource GuardianWarningLowBrush}"
                                    BorderBrush="{ThemeResource GuardianWarningBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="TRASLADO"
                                            Style="{StaticResource GuardianEyebrowTextStyle}"
                                            Foreground="{ThemeResource GuardianWarningBrush}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.DetailTransferSuggestionText, Mode=OneWay}"
                                            Style="{StaticResource GuardianMonoTextStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Background="{ThemeResource GuardianDangerLowBrush}"
                                    BorderBrush="{ThemeResource GuardianDangerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="PENDIENTE"
                                            Style="{StaticResource GuardianEyebrowTextStyle}"
                                            Foreground="{ThemeResource GuardianDangerBrush}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.DetailRemainingShortageText, Mode=OneWay}"
                                            Style="{StaticResource GuardianMonoTextStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid
                                Grid.Row="1"
                                MinHeight="0"
                                RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Text="{x:Bind ViewModel.DetailTransferStateText, Mode=OneWay}"
                                    Style="{StaticResource GuardianEyebrowTextStyle}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Text="{x:Bind ViewModel.DetailSubtitle, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Style="{StaticResource GuardianBodyTextStyle}" />

                                <ListView
                                    Grid.Row="2"
                                    MinHeight="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemContainerStyle="{StaticResource GuardianListViewItemStyle}"
                                    ItemsSource="{x:Bind ViewModel.ZoneDetails, Mode=OneWay}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:ZoneDetailRowViewModel">
                                            <Border
                                                Background="{ThemeResource GuardianBgElevatedBrush}"
                                                BorderBrush="{ThemeResource GuardianBorderSoftBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="12">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Text="{x:Bind StorageZone}"
                                                        TextWrapping="Wrap"
                                                        Style="{StaticResource GuardianBodyTextStyle}" />
                                                    <Border
                                                        Grid.Column="1"
                                                        Background="{x:Bind ZoneTypeBackgroundBrush}"
                                                        BorderBrush="{x:Bind ZoneTypeBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="18"
                                                        Padding="10,4">
                                                        <TextBlock
                                                            Text="{x:Bind ZoneTypeLabel}"
                                                            Foreground="{x:Bind ZoneTypeAccentBrush}"
                                                            Style="{StaticResource GuardianEyebrowTextStyle}" />
                                                    </Border>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Text="{x:Bind QuantityText}"
                                                        Style="{StaticResource GuardianMonoTextStyle}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid
            Grid.Row="1"
            Visibility="{x:Bind ViewModel.TransferViewVisibility, Mode=OneWay}"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Action bar: filter tabs + actions -->
            <Grid Grid.Row="0" ColumnSpacing="12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Background="{StaticResource StitchSurfaceSubtleBrush}"
                    BorderBrush="{StaticResource StitchBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="2">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Tag="Todos" Click="TransferTab_Click" Content="Todos" Padding="12,4" CornerRadius="4" BorderThickness="0"
                                Background="{x:Bind ViewModel.IsTabTodos, Mode=OneWay, Converter={StaticResource SelectedTabBackgroundBrushConverter}}"
                                Foreground="{x:Bind ViewModel.IsTabTodos, Mode=OneWay, Converter={StaticResource SelectedTabForegroundBrushConverter}}" />
                        <Button Tag="Criticos" Click="TransferTab_Click" Content="Criticos" Padding="12,4" CornerRadius="4" BorderThickness="0"
                                Background="{x:Bind ViewModel.IsTabCriticos, Mode=OneWay, Converter={StaticResource SelectedTabBackgroundBrushConverter}}"
                                Foreground="{x:Bind ViewModel.IsTabCriticos, Mode=OneWay, Converter={StaticResource SelectedTabForegroundBrushConverter}}" />
                        <Button Tag="Pendientes" Click="TransferTab_Click" Content="Pendientes" Padding="12,4" CornerRadius="4" BorderThickness="0"
                                Background="{x:Bind ViewModel.IsTabPendientes, Mode=OneWay, Converter={StaticResource SelectedTabBackgroundBrushConverter}}"
                                Foreground="{x:Bind ViewModel.IsTabPendientes, Mode=OneWay, Converter={StaticResource SelectedTabForegroundBrushConverter}}" />
                        <Button Tag="AltoVolumen" Click="TransferTab_Click" Content="Alto Volumen" Padding="12,4" CornerRadius="4" BorderThickness="0"
                                Background="{x:Bind ViewModel.IsTabAltoVolumen, Mode=OneWay, Converter={StaticResource SelectedTabBackgroundBrushConverter}}"
                                Foreground="{x:Bind ViewModel.IsTabAltoVolumen, Mode=OneWay, Converter={StaticResource SelectedTabForegroundBrushConverter}}" />
                        <Button Tag="AlistadoSatelital" Click="TransferTab_Click" Content="Alistado Sat." Padding="12,4" CornerRadius="4" BorderThickness="0"
                                Background="{x:Bind ViewModel.IsTabAlistadoSatelital, Mode=OneWay, Converter={StaticResource SelectedTabBackgroundBrushConverter}}"
                                Foreground="{x:Bind ViewModel.IsTabAlistadoSatelital, Mode=OneWay, Converter={StaticResource SelectedTabForegroundBrushConverter}}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.ClearOrdersCommand}" Style="{StaticResource GuardianSecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Style="{StaticResource GuardianIconStyle}" FontSize="18" Glyph="&#xE0B8;" />
                            <TextBlock Text="Limpiar seleccion" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.SendSelectedToTransitCommand}" Style="{StaticResource GuardianPrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Style="{StaticResource GuardianIconStyle}" FontSize="18" Glyph="&#xE7C3;" Foreground="{ThemeResource GuardianOnPrimaryBrush}" />
                            <TextBlock Text="Mandar a pedir" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ExportRequisitionCommand}" Style="{StaticResource GuardianPrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Style="{StaticResource GuardianIconStyle}" FontSize="18" Glyph="&#xF090;" Foreground="{ThemeResource GuardianOnPrimaryBrush}" />
                            <TextBlock Text="Exportar requisicion" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Funnel cards -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource StitchMetricCardStyle}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="1. EVALUADOS" Foreground="{StaticResource StitchTextMutedBrush}" Style="{StaticResource GuardianEyebrowTextStyle}" />
                            <TextBlock Text="Catalogo activo" HorizontalAlignment="Right" FontSize="11" FontWeight="Medium" Foreground="{StaticResource StitchTextMutedBrush}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                            <TextBlock Text="{x:Bind ViewModel.FunnelEvaluated, Mode=OneWay}" FontFamily="{StaticResource GuardianDisplayFontFamily}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource StitchTextPrimaryBrush}" />
                            <TextBlock Text="SKUs analizados" VerticalAlignment="Bottom" Margin="0,0,0,5" FontSize="12" FontWeight="Medium" Foreground="{StaticResource StitchTextMutedBrush}" />
                        </StackPanel>
                        <ProgressBar Value="100" Maximum="100" Height="4" Foreground="{StaticResource StitchTextSoftBrush}" Background="{StaticResource StitchSurfaceSubtleBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource StitchMetricCardStyle}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="2. ALCANZAN" Foreground="{StaticResource StitchTextMutedBrush}" Style="{StaticResource GuardianEyebrowTextStyle}" />
                            <Border HorizontalAlignment="Right" Background="{StaticResource StitchSurfaceSubtleBrush}" CornerRadius="4" Padding="6,1">
                                <TextBlock Text="{x:Bind ViewModel.FunnelCoveredPercentText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource StitchTextPrimaryBrush}" />
                            </Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                            <TextBlock Text="{x:Bind ViewModel.FunnelCovered, Mode=OneWay}" FontFamily="{StaticResource GuardianDisplayFontFamily}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource StitchTextPrimaryBrush}" />
                            <TextBlock Text="Cubiertos en principal" VerticalAlignment="Bottom" Margin="0,0,0,5" FontSize="12" FontWeight="Medium" Foreground="{StaticResource StitchTextMutedBrush}" />
                        </StackPanel>
                        <ProgressBar Value="{x:Bind ViewModel.FunnelCovered, Mode=OneWay}" Maximum="{x:Bind ViewModel.FunnelEvaluated, Mode=OneWay}" Height="4" Foreground="{StaticResource StitchBlackBrush}" Background="{StaticResource StitchSurfaceSubtleBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StitchPrimaryMetricCardStyle}">
                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="3. TRASLADOS" Foreground="{StaticResource StitchPrimaryBrush}" Style="{StaticResource GuardianEyebrowTextStyle}" />
                        <Border Grid.Column="1" Background="{StaticResource StitchPrimaryBrush}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="ACCION PRIORITARIA" FontSize="10" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                            <TextBlock Text="{x:Bind ViewModel.FunnelToTransfer, Mode=OneWay}" FontFamily="{StaticResource GuardianDisplayFontFamily}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource StitchTextPrimaryBrush}" />
                            <TextBlock Text="SKUs a trasladar" VerticalAlignment="Bottom" Margin="0,0,0,5" FontSize="12" FontWeight="Medium" Foreground="{StaticResource StitchPrimaryBrush}" />
                        </StackPanel>
                        <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,0" Value="100" Maximum="100" Height="6" Foreground="{StaticResource StitchPrimaryBrush}" Background="{StaticResource StitchPrimaryBorderBrush}" />
                    </Grid>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource StitchMetricCardStyle}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="4. SIN BODEGA EXTERNA" Foreground="{StaticResource StitchTextMutedBrush}" Style="{StaticResource GuardianEyebrowTextStyle}" />
                            <TextBlock Text="Faltante" HorizontalAlignment="Right" FontSize="11" FontWeight="Medium" Foreground="{StaticResource StitchTextPrimaryBrush}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                            <TextBlock Text="{x:Bind ViewModel.FunnelWithoutExternal, Mode=OneWay}" FontFamily="{StaticResource GuardianDisplayFontFamily}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource StitchTextPrimaryBrush}" />
                            <TextBlock Text="SKUs a requisar" VerticalAlignment="Bottom" Margin="0,0,0,5" FontSize="12" FontWeight="Medium" Foreground="{StaticResource StitchTextMutedBrush}" />
                        </StackPanel>
                        <ProgressBar Value="{x:Bind ViewModel.FunnelWithoutExternal, Mode=OneWay}" Maximum="{x:Bind ViewModel.FunnelEvaluated, Mode=OneWay}" Height="4" Foreground="{StaticResource StitchBorderBrush}" Background="{StaticResource StitchSurfaceSubtleBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Data grid card -->
            <Border Grid.Row="2" Style="{StaticResource StitchPanelBorderStyle}" Padding="0">
                <SplitView
                    CompactPaneLength="0"
                    DisplayMode="Overlay"
                    IsPaneOpen="False"
                    OpenPaneLength="0"
                    PanePlacement="Right">
                    <SplitView.Pane>
                        <Border
                            Width="390"
                            Padding="16"
                            Background="{StaticResource StitchSurfaceBrush}"
