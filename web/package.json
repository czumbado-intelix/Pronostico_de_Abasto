{
  "name": "pronostico-abasto-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "cf:types": "wrangler types --path ./src/worker-configuration.d.ts",
    "cf:dev": "npm run build && wrangler pages dev ./dist",
    "cf:migrate:local": "wrangler d1 migrations apply pronostico-abasto --local",
    "cf:migrate:remote": "wrangler d1 migrations apply pronostico-abasto --remote",
    "backup:remote": "powershell -ExecutionPolicy Bypass -File ./scripts/Export-D1Backup.ps1"
  },
  "dependencies": {
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.20",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  }
}
